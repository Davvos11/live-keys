// The structs the host (Rust) and the UI exchange; re-exported by
// `globals.slint`. Kept apart so `mock_data.slint` can use them.

// One plugin in the plugin picker's list.
export struct PickerRow {
    // `PluginInfo::id`: an LV2 URI or `vst3:` + class ID.
    id: string,
    name: string,
    // "LV2" or "VST3".
    format: string,
    pinned: bool,
    // The first unpinned row after some pinned ones, drawn with a divider above.
    after-pinned: bool,
}

export struct ParamRow {
    param-id: int,
    name: string,
    // As `ParamKind`: 0 continuous, 1 toggle, 2 stepped, 3 choice, 4 note.
    kind: int,
    min-value: float,
    max-value: float,
    // Steps between min and max for stepped/note parameters; 0 otherwise.
    steps: int,
    // Continuous parameter shown on a logarithmic slider (min-value > 0).
    logarithmic: bool,
    // Last value sent to the plugin (from a control or the plugin's own GUI), so
    // a rebuilt control shows where the parameter actually is, not its default.
    value: float,
    // `value` as the plugin or its metadata would show it ("-6 dB", "C#3").
    text: string,
    // A choice parameter's option labels, their values, and the current one.
    choices: [string],
    choice-values: [float],
    choice-index: int,
}

// One preset in the preset browser.
export struct PresetRow {
    name: string,
    // Saved by the user (and so deletable).
    user: bool,
    // A favourite, listed first.
    pinned: bool,
    // The first non-favourite row after some favourites, drawn with a divider above.
    after-pinned: bool,
    // The preset last loaded or saved.
    current: bool,
}

// One plugin (an instrument or a MIDI or audio effect) in a slot's chain.
export struct EffectRow {
    // The engine's `PluginKey` of this instance, or -1 for no plugin.
    key: int,
    name: string,
    // Whether the plugin has any GUI this host can show at all.
    gui-supported: bool,
    // Whether we currently believe the plugin's GUI session is open. A plugin's
    // own UI can wedge internally (observed with some External UI plugins) and
    // never signal back that it closed — "GUI" lets the user force this back to
    // false so they can at least try a fresh session, independent of whatever
    // the previous one's hosting thread is stuck doing.
    gui-open: bool,
    // Whether its parameter window is open.
    params-open: bool,
    // The curve its FX square shows: 0 none, 1 compressor, 2 filter (from its
    // name; a placeholder until plugins can be asked).
    graph: int,
    // Its inline display (Ardour's LV2 extension), rendered from the plugin,
    // which its FX square shows instead of the name and curve.
    display: image,
    has-display: bool,
    // The preset last loaded or saved; empty if none.
    preset-name: string,
    // Whether that preset was saved by the user (and so can be deleted).
    preset-user: bool,
    // Whether a parameter changed since that preset was loaded or saved.
    preset-changed: bool,
}

// One row of a slot's slot-preset browser: an instrument's folder, or a preset.
export struct SlotPresetRow {
    name: string,
    folder: bool,
    // A folder's number of presets.
    count: int,
    // The slot's current preset.
    current: bool,
}

// A MIDI device as offered for one MIDI input.
export struct MidiDeviceRow {
    name: string,
    // Whether it feeds this input.
    checked: bool,
    // Whether it's plugged in now.
    available: bool,
}

// One of the MIDI inputs slots can listen to.
export struct MidiInputRow {
    // Its devices, for the button that opens the device list.
    summary: string,
    // Every device plugged in, then this input's devices that aren't.
    devices: [MidiDeviceRow],
}

// One scene in the Live tab's scene list.
export struct SceneRow {
    name: string,
    // The scene last recalled or saved.
    current: bool,
    // Per slot, what recalling it does: 0 leave unchanged, 1 restore, 2 clear.
    modes: [int],
}

// One slot in the scene save/edit form.
export struct SceneSlotChoice {
    // As in `SceneRow.modes`.
    mode: int,
    // Whether there's (or, when saving, will be) a setup to restore.
    can-restore: bool,
}

// One cell of the row on a slot's first tab: a control of the instrument's
// panel (see `src/profiles.rs`).
export struct PanelCell {
    // As `profiles::Widget`: 0 knob, 1 switch, 2 lever; -1 an empty cell (the
    // row has fewer controls than cells, and the pool more to offer).
    widget: int,
    // The caption under the control.
    label: string,
    // A switch's word on its button.
    text: string,
    // A knob without choices: its position, 0..1, where a reset (double-click)
    // puts it, and how many steps it snaps to (0: continuous).
    position: float,
    default-position: float,
    steps: int,
    // A switch: whether it's on.
    on: bool,
    // A lever or a knob with choices (a stepped knob): the options, the
    // current one and where a reset puts it.
    choices: [string],
    index: int,
    default-index: int,
    // The value as text, shown while a knob is hovered or turned.
    value-text: string,
}

// One drawbar of a slot's fixed section.
export struct DrawbarCell {
    // Its footage ("16'").
    label: string,
    // 0 brown, 1 white, 2 black.
    colour: int,
    // How far it's pulled out, 0..=8.
    level: int,
}

// One control of the instrument panel's pool, as a cell's context menu lists
// it.
export struct PanelPoolRow {
    // Its index in the pool (the menu leaves some out when the pool is long).
    index: int,
    name: string,
    // The row cell showing it, or -1.
    cell: int,
}

// One rack slot on the Live tab: MIDI effects, an instrument, then audio
// effects.
export struct SlotState {
    // The header photo, by `Artwork`'s numbering (from the instrument's name).
    artwork: int,
    // Silenced by its mute button.
    muted: bool,
    // Semitones added to the notes it plays.
    transpose: int,
    // The instrument name of a slot that was just cleared and can still be
    // brought back (Undo); empty otherwise.
    closed-name: string,
    // The instrument's panel: its fixed section's drawbars (usually none), the
    // row of cells, and the pool the cells' context menu offers.
    drawbars: [DrawbarCell],
    cells: [PanelCell],
    pool: [PanelPoolRow],
    // Its key is -1 when no instrument is loaded into this slot.
    instrument: EffectRow,
    // The last load/open/preset error; empty if none.
    status: string,
    // In processing order, in front of the instrument.
    midi-effects: [EffectRow],
    // In processing order, after the instrument.
    audio-effects: [EffectRow],
    // Per MIDI input (as `AppState.midi-inputs`), whether this slot listens to it.
    midi-inputs: [bool],
    // MIDI this slot responds to. Channel is 0 for omni, else 1-16; note and
    // velocity ranges are inclusive.
    midi-channel: int,
    note-low: int,
    note-high: int,
    velocity-low: int,
    velocity-high: int,
    volume-db: float,
    // MIDI learn: per row cell and drawbar, and for the volume, mute and
    // transposition, 0 not a target, 1 a possible one, 2 the selected
    // control's (see `AppState.learning`).
    cell-learn: [int],
    drawbar-learn: [int],
    volume-learn: int,
    mute-learn: int,
    transpose-learn: int,
    // The slot preset last loaded or saved; empty if none.
    slot-preset-name: string,
    // Whether the chain or a parameter changed since.
    slot-preset-changed: bool,
    // The instrument folder the slot-preset browser shows; empty when it lists
    // the folders.
    slot-preset-folder: string,
    slot-preset-rows: [SlotPresetRow],
}

// One control of a control surface, as drawn in the bottom panel.
export struct SurfaceControlView {
    // 0 fader, 1 knob, 2 pad, 3 button.
    kind: int,
    label: string,
    // Its cell in the surface's drawing, in pixels.
    x: float,
    y: float,
    width: float,
    height: float,
    // What it last sent, 0..1: a fader's or knob's position, a pad's velocity
    // or pressure.
    value: float,
    // A pad or button held down.
    pressed: bool,
    // A fader or knob moved a moment ago.
    moving: bool,
    // Whether it drives anything (MIDI learn).
    mapped: bool,
    // MIDI learn's selected control.
    selected: bool,
    // Its target is elsewhere (`target`, as a position of the control): the
    // control is drawn there, the hardware's `value` as a ghost.
    waiting: bool,
    target: float,
}

// One level of a MIDI-learn toggle: its position 0..1 along the target's
// control, and that as the target's value.
export struct LearnLevel {
    position: float,
    text: string,
}

// One target of MIDI learn's selected control (a row of the targets pane, or
// the right-click popup's). `mode`: 0 direct, 1 mirrored, 3 toggle, 4
// momentary. `kept`: 0 with the scene, 1 in every scene. `panel`: -1 not a
// panel control, 0 this parameter, 1 this panel position.
export struct LearnTargetRow {
    name: string,
    place: string,
    chip: string,
    greyed: bool,
    mode: int,
    from: float,
    to: float,
    from-text: string,
    to-text: string,
    levels: [LearnLevel],
    value: float,
    value-text: string,
    velocity: bool,
    kept: int,
    can-keep-with-scene: bool,
    panel: int,
}

// MIDI learn's selected control. `kind`: 0 fader, 1 knob, 2 pad, 3 button.
// `takeover`: 0 jump, 1 glide, 2 pick up.
export struct LearnControl {
    selected: bool,
    label: string,
    detail: string,
    kind: int,
    takeover: int,
    pass-through: bool,
}

// A MIDI device shown in the control surfaces panel.
export struct SurfaceView {
    // The surface's name, or the device's when there's no surface for it.
    name: string,
    device: string,
    // Whether a surface is known for the device.
    known: bool,
    // Whether the device is plugged in.
    connected: bool,
    // Its drawing's size, in pixels.
    width: float,
    height: float,
    controls: [SurfaceControlView],
}
