import { PickerRow, ParamRow, PresetRow, EffectRow, SlotPresetRow, MidiDeviceRow, MidiInputRow, SceneRow, SceneSlotChoice, SlotState, KnobRow } from "types.slint";
import { MockData } from "mock_data.slint";

export { PickerRow, ParamRow, PresetRow, EffectRow, SlotPresetRow, MidiDeviceRow, MidiInputRow, SceneRow, SceneSlotChoice, SlotState, KnobRow } from "types.slint";

// State the host (Rust) pushes into the UI.
export global AppState {
    // Each property below that the host fills defaults to `MockData`'s in the
    // editor's preview (`Platform.uses-mock-data`; the app compiles that away),
    // so the UI previews with a real session's state.
    in property <[string]> audio-devices: Platform.uses-mock-data ? MockData.audio-devices : [];
    // ComboBox writes to `current-value` don't update its visual selection
    // (https://github.com/slint-ui/slint/issues/11970) — drive it by index instead.
    in property <int> selected-audio-index: Platform.uses-mock-data ? MockData.selected-audio-index : -1;
    in property <[MidiInputRow]> midi-inputs: Platform.uses-mock-data ? MockData.midi-inputs : [];
    in property <int> max-midi-inputs: 8;
    // The scene list, filtered by `AppLogic.filter-scenes`; `scene-count` is
    // every scene, matching or not.
    in property <[SceneRow]> scene-rows: Platform.uses-mock-data ? MockData.scene-rows : [];
    in property <int> scene-count: Platform.uses-mock-data ? MockData.scene-count : 0;
    // The scene last recalled or saved ("" if none), and whether any slot it
    // includes changed since.
    in property <string> current-scene: Platform.uses-mock-data ? MockData.current-scene : "";
    in property <bool> current-scene-changed: Platform.uses-mock-data ? MockData.current-scene-changed : false;
    // Per slot, its mode in the scene being saved or edited (set by
    // `AppLogic.begin-scene-save`/`begin-scene-edit`, changed by
    // `set-scene-slot-mode`).
    in property <[SceneSlotChoice]> scene-form-slots: Platform.uses-mock-data ? MockData.scene-form-slots : [];
    // The last scene error; empty if none.
    in property <string> scene-status: Platform.uses-mock-data ? MockData.scene-status : "";
    // The name of the scene being saved over, edited or deleted (for saving:
    // the current scene's, "" if none).
    in property <string> scene-target-name: Platform.uses-mock-data ? MockData.scene-target-name : "";
    in property <[string]> default-plugin-folders: Platform.uses-mock-data ? MockData.default-plugin-folders : [];
    in property <[string]> extra-plugin-folders: Platform.uses-mock-data ? MockData.extra-plugin-folders : [];
    // Until the first plugin scan is installed and the last session restored:
    // nothing is loaded or playing yet, so the Live tab shows a spinner instead.
    // Off in the preview, which shows the tab with `MockData`.
    in property <bool> starting: !Platform.uses-mock-data;
    // Whether a plugin scan is running (from startup, or Rescan); not in
    // `MockData`, since the app never exits mid-scan.
    in property <bool> scanning: false;
    // Every plugin found, as "name — kind (format)", for the Settings tab.
    in property <[string]> discovered-plugins: Platform.uses-mock-data ? MockData.discovered-plugins : [];
    // The plugin picker's list for its current category and search, pinned
    // plugins first; refilled by `AppLogic.filter-picker`.
    in property <[PickerRow]> picker-rows: Platform.uses-mock-data ? MockData.picker-rows : [];
    in property <int> max-midi-effects: 8;
    in property <int> max-effects: 8;
    in property <[SlotState]> slots: Platform.uses-mock-data ? MockData.slots : [];
    // Volume fader range; the minimum means muted.
    in property <float> min-volume-db: -60;
    in property <float> max-volume-db: 6;
    // Transposition range, in semitones either way.
    in property <int> max-transpose: 48;
    // The plugin whose preset browser is open, or -1; one at a time.
    in property <int> preset-browser-key: Platform.uses-mock-data ? MockData.preset-browser-key : -1;
    // Its presets matching `preset-query`, favourites first, and how many
    // presets it has in all.
    in property <[PresetRow]> preset-rows: Platform.uses-mock-data ? MockData.preset-rows : [];
    in property <int> preset-count: Platform.uses-mock-data ? MockData.preset-count : 0;
    in property <string> preset-query: Platform.uses-mock-data ? MockData.preset-query : "";
}

// Plugin categories, as the picker's tabs and `category` arguments number them.
export global Category {
    out property <int> instrument: 0;
    out property <int> midi-effect: 1;
    out property <int> audio-effect: 2;
}

// Actions the UI triggers that the host (Rust) handles. `slot` arguments index
// `AppState.slots`; `key` arguments are a loaded plugin's `PluginKey`;
// `category` is as in `Category`; `section` is 0 for a slot's MIDI effects and
// 1 for its audio effects.
export global AppLogic {
    callback select-audio-device(string);
    callback add-midi-input();
    // Input 0 can't be removed.
    callback remove-midi-input(/* input */ int);
    // Adds the device to the input, or takes it off.
    callback toggle-midi-device(/* input */ int, /* device name */ string);
    // Makes the slot listen to the input, or stop listening.
    callback toggle-slot-input(/* slot */ int, /* input */ int);
    callback add-plugin-folder();
    callback remove-plugin-folder(string);
    callback rescan-plugins();
    // Refills `AppState.picker-rows` with `category`'s plugins matching `query`.
    callback filter-picker(/* category */ int, /* query */ string);
    callback toggle-pin(/* plugin id */ string);
    // Loads the plugin as the slot's instrument (replacing any) or appends it
    // to the slot's MIDI or audio effects, depending on `category`.
    callback pick-plugin(/* slot */ int, /* category */ int, /* plugin id */ string);
    callback unload-plugin(/* slot */ int);
    // Removes every plugin from the slot, keeping what was there for
    // `undo-clear` (shown through `SlotState.closed-name`).
    callback clear-slot(/* slot */ int);
    // Puts back what `clear-slot` removed: the chain, its settings, routing and
    // volume.
    callback undo-clear(/* slot */ int);
    // Forgets what `clear-slot` removed, leaving the slot empty.
    callback dismiss-closed(/* slot */ int);
    callback toggle-slot-mute(/* slot */ int);
    callback set-slot-transpose(/* slot */ int, /* semitones */ int);
    callback remove-effect(/* slot */ int, /* section */ int, /* index */ int);
    callback move-effect(/* slot */ int, /* section */ int, /* from */ int, /* to */ int);
    // Opens `key`'s parameter window, or closes it if open.
    callback toggle-params(/* key */ int);
    callback open-plugin-gui(/* key */ int);
    callback close-plugin-gui(/* key */ int);
    // Invoked by the Rust side for a `ParamsWindow`'s edits (a separate window
    // can't reach this window's globals itself).
    callback set-param(/* key */ int, /* param-id */ int, float);
    // Presets. The browser's actions act on `AppState.preset-browser-key`'s
    // plugin; `index` is into `AppState.preset-rows`.
    callback open-preset-browser(/* key */ int);
    callback close-preset-browser();
    // Shows the presets whose name contains every word of `query`.
    callback filter-presets(/* query */ string);
    // Loads the preset and closes the browser.
    callback load-preset(/* index */ int);
    // Adds the preset to the favourites, or removes it.
    callback toggle-preset-pin(/* index */ int);
    callback save-preset(/* key */ int, /* name */ string);
    // Deletes the plugin's current preset.
    callback delete-preset(/* key */ int);
    // Slot presets. Choosing a folder row opens it; choosing a preset loads it.
    callback choose-slot-preset(/* slot */ int, /* index into slot-preset-rows */ int);
    // Back from a folder to the list of folders.
    callback show-slot-preset-folders(/* slot */ int);
    callback save-slot-preset(/* slot */ int, /* name */ string);
    // Deletes the slot's current slot preset.
    callback delete-slot-preset(/* slot */ int);
    // Channel uses the same encoding as `SlotState.midi-channel`.
    callback set-slot-filter(/* slot */ int, /* channel */ int, /* note-low */ int, /* note-high */ int, /* velocity-low */ int, /* velocity-high */ int);
    callback set-slot-volume(/* slot */ int, /* dB */ float);
    // Scenes. `index` is into `AppState.scene-rows`; -1 means the current scene.
    callback filter-scenes(/* query */ string);
    callback load-scene(/* index */ int);
    // Fills the form's slot modes: the current scene's, else restore for
    // every slot with plugins and leave unchanged for the others.
    callback begin-scene-save();
    // Makes the scene the one to edit, and fills the form from it.
    callback begin-scene-edit(/* index */ int);
    // Makes the scene the one to delete.
    callback begin-scene-delete(/* index */ int);
    callback set-scene-slot-mode(/* slot */ int, /* mode */ int);
    callback save-scene(/* name */ string);
    // Saves the slots' current setups over the scene, keeping its slot modes.
    callback overwrite-scene(/* index */ int);
    // Renames the scene being edited and gives it the form's slot modes.
    callback edit-scene(/* name */ string);
    callback delete-scene();
    // Copies the scene as "<name> copy", right after it.
    callback duplicate-scene(/* index */ int);
    // Moves the scene at row `from` to row `to`.
    callback move-scene(/* from */ int, /* to */ int);
}
