import { PickerRow, ParamRow, PresetRow, EffectRow, SlotPresetRow, MidiDeviceRow, MidiInputRow, SceneRow, SceneSlotChoice, SlotState, PanelCell, DrawbarCell, PanelPoolRow, SurfaceControlView, SurfaceView, LearnLevel, LearnTargetRow, LearnControl, EditBank, EditBankSettings } from "types.slint";
import { MockData } from "mock_data.slint";

export { PickerRow, ParamRow, PresetRow, EffectRow, SlotPresetRow, MidiDeviceRow, MidiInputRow, SceneRow, SceneSlotChoice, SlotState, PanelCell, DrawbarCell, PanelPoolRow, SurfaceControlView, SurfaceView, LearnLevel, LearnTargetRow, LearnControl, EditBank, EditBankSettings } from "types.slint";

// State the host (Rust) pushes into the UI.
export global AppState {
    // Each property below that the host fills defaults to `MockData`'s in the
    // editor's preview (`Platform.uses-mock-data`; the app compiles that away),
    // so the UI previews with a real session's state.
    in property <[string]> audio-devices: Platform.uses-mock-data ? MockData.audio-devices : [];
    // ComboBox writes to `current-value` don't update its visual selection
    // (https://github.com/slint-ui/slint/issues/11970) — drive it by index instead.
    in property <int> selected-audio-index: Platform.uses-mock-data ? MockData.selected-audio-index : -1;
    in property <[MidiInputRow]> midi-inputs: Platform.uses-mock-data ? MockData.midi-inputs : [];
    in property <int> max-midi-inputs: 8;
    // The control surfaces panel: the devices shown, every device that can be
    // (plugged in, or shown and not), a summary of the shown ones, whether the
    // panel is collapsed (the user's choice), and whether any shown device
    // sent something a moment ago.
    in property <[SurfaceView]> surfaces: Platform.uses-mock-data ? MockData.surfaces : [];
    in property <[MidiDeviceRow]> surface-devices: Platform.uses-mock-data ? MockData.surface-devices : [];
    in property <string> surface-summary: Platform.uses-mock-data ? MockData.surface-summary : "";
    in property <bool> surfaces-collapsed: false;
    in property <bool> surface-activity: false;
    // MIDI learn: on; the selected control; its targets (the pane over the
    // scenes) and which one is expanded (-1: none); the right-click popup's
    // target and whether it's assigned yet. The sidebar's targets' states
    // are as `SlotState`'s learn fields (the master's volume, mute and
    // transposition, the metronome's volume, play and tempo).
    in property <bool> learning: Platform.uses-mock-data ? MockData.learning : false;
    in property <LearnControl> learn-control: Platform.uses-mock-data ? MockData.learn-control : { };
    in property <[LearnTargetRow]> learn-rows: Platform.uses-mock-data ? MockData.learn-rows : [];
    in property <int> learn-expanded: -1;
    in property <LearnTargetRow> learn-popup;
    in property <bool> learn-popup-assigned;
    in property <int> master-volume-learn;
    in property <int> master-mute-learn;
    in property <int> master-transpose-learn;
    in property <int> metronome-volume-learn;
    in property <int> metronome-play-learn;
    in property <int> tempo-learn;
    // The surface editor: on; the device and the surface's name; the surface
    // as laid out, its banks' frames and the selected bank (-1: none) with its
    // settings; what it's listening for (0 nothing, 1 a bank's controls in
    // turn, 2 one control, 3 every new control) and its status line; and
    // whether there's a user file to delete.
    in property <bool> editing;
    in property <string> edit-device;
    in property <string> edit-name;
    in property <SurfaceView> edit-surface;
    in property <[EditBank]> edit-banks;
    in property <int> edit-selected: -1;
    in property <EditBankSettings> edit-bank;
    in property <int> edit-listening;
    in property <string> edit-status;
    in property <bool> edit-can-delete;
    // The scene list, filtered by `AppLogic.filter-scenes`; `scene-count` is
    // every scene, matching or not.
    in property <[SceneRow]> scene-rows: Platform.uses-mock-data ? MockData.scene-rows : [];
    in property <int> scene-count: Platform.uses-mock-data ? MockData.scene-count : 0;
    // The scene last recalled or saved ("" if none), and whether any slot it
    // includes changed since.
    in property <string> current-scene: Platform.uses-mock-data ? MockData.current-scene : "";
    in property <bool> current-scene-changed: Platform.uses-mock-data ? MockData.current-scene-changed : false;
    // Per slot, its mode in the scene being saved or edited (set by
    // `AppLogic.begin-scene-save`/`begin-scene-edit`, changed by
    // `set-scene-slot-mode`).
    in property <[SceneSlotChoice]> scene-form-slots: Platform.uses-mock-data ? MockData.scene-form-slots : [];
    // The last scene error; empty if none.
    in property <string> scene-status: Platform.uses-mock-data ? MockData.scene-status : "";
    // The name of the scene being saved over, edited or deleted (for saving:
    // the current scene's, "" if none).
    in property <string> scene-target-name: Platform.uses-mock-data ? MockData.scene-target-name : "";
    // Until the first plugin scan is installed and the last session restored:
    // nothing is loaded or playing yet, so the Live tab shows a spinner instead.
    // Off in the preview, which shows the tab with `MockData`.
    in property <bool> starting: !Platform.uses-mock-data;
    // Whether a plugin scan is running (from startup, or Rescan); not in
    // `MockData`, since the app never exits mid-scan.
    in property <bool> scanning: false;
    // A built-in instrument's sample download: 0 none, 1 offered (picking the
    // instrument found its samples missing), 2 downloading, 3 failed. Its title,
    // the text under it (what, how big, where; or the error), how far it is
    // (0..1) and a progress line. Not in `MockData`.
    in property <int> download-state: 0;
    in property <string> download-title;
    in property <string> download-text;
    in property <float> download-progress;
    in property <string> download-status;
    // The plugin picker's list for its current category and search, pinned
    // plugins first; refilled by `AppLogic.filter-picker`.
    in property <[PickerRow]> picker-rows: Platform.uses-mock-data ? MockData.picker-rows : [];
    in property <int> max-midi-effects: 8;
    in property <int> max-effects: 8;
    in property <[SlotState]> slots: Platform.uses-mock-data ? MockData.slots : [];
    // Volume fader range; the minimum means muted.
    in property <float> min-volume-db: -60;
    in property <float> max-volume-db: 6;
    // Transposition range, in semitones either way.
    in property <int> max-transpose: 48;
    // The plugin whose preset browser is open, or -1; one at a time.
    in property <int> preset-browser-key: Platform.uses-mock-data ? MockData.preset-browser-key : -1;
    // Its presets matching `preset-query`, favourites first, and how many
    // presets it has in all.
    in property <[PresetRow]> preset-rows: Platform.uses-mock-data ? MockData.preset-rows : [];
    in property <int> preset-count: Platform.uses-mock-data ? MockData.preset-count : 0;
    in property <string> preset-query: Platform.uses-mock-data ? MockData.preset-query : "";
    // "More parameters…" of a panel cell's context menu (one at a time): the
    // instrument's parameters matching the search, by name, and how many it
    // has in all. Filled by `AppLogic.open-param-search`/`filter-param-search`.
    in property <[string]> param-search-rows: Platform.uses-mock-data ? MockData.param-search-rows : [];
    in property <int> param-search-count: Platform.uses-mock-data ? MockData.param-search-count : 0;
    // The master chain's index wherever a slot index goes (`pick-plugin`,
    // `remove-effect`, `move-effect`): audio effects only.
    in property <int> master-slot: 6;
    // The selected slot (what "the selected slot" mappings drive).
    in property <int> selected-slot: Platform.uses-mock-data ? MockData.selected-slot : 0;
    in property <[EffectRow]> master-effects: Platform.uses-mock-data ? MockData.master-effects : [];
    in property <float> master-volume-db: Platform.uses-mock-data ? MockData.master-volume-db : 0;
    in property <bool> master-muted: false;
    // Semitones added to every slot's notes, on top of each slot's own.
    in property <int> master-transpose: Platform.uses-mock-data ? MockData.master-transpose : 0;
    // The master chain's last error; empty if none.
    in property <string> master-status;
    // The metronome. `metronome-beat` is the beat it's on (0 = a bar's first),
    // -1 while stopped; `metronome-volume` is 0..1.
    in property <bool> metronome-playing: false;
    in property <int> metronome-bpm: Platform.uses-mock-data ? MockData.metronome-bpm : 120;
    in property <int> min-bpm: 20;
    in property <int> max-bpm: 300;
    in property <float> metronome-volume: 0.5;
    in property <int> metronome-beats: 4;
    in property <int> metronome-beat: -1;
    // Its time signature and subdivision, as indices into the lists of each.
    in property <[string]> metronome-signatures;
    in property <int> metronome-signature;
    in property <[string]> metronome-subdivisions;
    in property <int> metronome-subdivision;
}

// Plugin categories, as the picker's tabs and `category` arguments number them.
export global Category {
    out property <int> instrument: 0;
    out property <int> midi-effect: 1;
    out property <int> audio-effect: 2;
}

// Actions the UI triggers that the host (Rust) handles. `slot` arguments index
// `AppState.slots`; `key` arguments are a loaded plugin's `PluginKey`;
// `category` is as in `Category`; `section` is 0 for a slot's MIDI effects and
// 1 for its audio effects.
export global AppLogic {
    callback select-audio-device(string);
    // Shows or hides MIDI device `name` in the control surfaces panel.
    callback toggle-surface-device(/* name */ string);
    // Collapses the control surfaces panel to one row, or expands it.
    callback set-surfaces-collapsed(/* collapsed */ bool);
    // MIDI learn: starts or stops it; selects a surface control (starting
    // it); clicks or right-clicks a learn target (`kind`: 0 a panel cell, 1 a
    // drawbar, 2 a volume, 3 a mute, 4 a transposition — `slot` the master's
    // for the sidebar's —, 5 the metronome's volume, 6 its play, 7 its tempo;
    // `index` the cell or drawbar). `row` arguments are the targets pane's
    // rows, -1 the popup's target.
    callback set-learning(/* on */ bool);
    callback learn-select(/* device */ string, /* control */ int);
    // Shows a page of a surface (for learning; the hardware switches pages itself).
    callback surface-page(/* device */ string, /* page */ int);
    // The next (step 1) or previous (-1) variant of the shown page.
    callback surface-variant(/* device */ string, /* step */ int);
    // Selects a slot (what "the selected slot" mappings drive).
    callback select-slot(/* slot */ int);
    // Loads the preset `step` presets on from the current one of a slot's instrument.
    callback step-instrument-preset(/* slot */ int, /* step */ int);
    // Switches a surface's driver (e.g. a keyboard's DAW mode) on or off.
    callback toggle-surface-driver(/* device */ string);
    callback learn-click(/* kind */ int, /* slot */ int, /* index */ int);
    callback learn-menu(/* kind */ int, /* slot */ int, /* index */ int);
    callback learn-assign-popup();
    callback learn-expand(/* row */ int);
    callback learn-remove(/* row */ int);
    callback learn-remove-all();
    callback learn-set-mode(/* row */ int, /* mode */ int);
    callback learn-set-range(/* row */ int, /* from */ float, /* to */ float);
    callback learn-set-level(/* row */ int, /* level */ int, /* position */ float);
    callback learn-add-level(/* row */ int);
    callback learn-remove-level(/* row */ int, /* level */ int);
    callback learn-set-value(/* row */ int, /* position */ float);
    callback learn-set-velocity(/* row */ int, /* on */ bool);
    // Where it's kept (0 with the scene, 1 in every scene) and, for a panel
    // control, whether it's that parameter or that panel position.
    callback learn-set-kept(/* row */ int, /* kept */ int, /* panel position */ bool);
    callback learn-set-takeover(/* 0 jump, 1 glide, 2 pick up */ int);
    callback learn-set-pass-through(/* on */ bool);
    // The surface editor: opens it for a device (`learn`: listening for every
    // new control straight away); closes it, saving or not; adds a bank (or
    // a single control) of `kind` (as `EditBankSettings.kind`); selects,
    // moves and deletes banks; changes the selected bank's settings (`field`
    // is an `EditBankSettings` field name); learns (`what` as
    // `AppState.edit-listening`), one control, skips one, stops.
    callback edit-surface(/* device */ string, /* learn */ bool);
    callback edit-finish(/* save */ bool);
    callback edit-add(/* kind */ int, /* single */ bool);
    callback edit-select-bank(/* bank */ int);
    callback edit-move-bank(/* bank */ int, /* x */ float, /* y */ float);
    callback edit-delete-bank();
    callback edit-set-name(/* name */ string);
    callback edit-bank-name(/* name */ string);
    callback edit-bank-set(/* field */ string, /* value */ int);
    callback edit-learn(/* what */ int);
    callback edit-learn-control(/* control */ int);
    callback edit-skip();
    callback edit-stop();
    callback edit-delete-surface();
    callback add-midi-input();
    // Input 0 can't be removed.
    callback remove-midi-input(/* input */ int);
    // Adds the device to the input, or takes it off.
    callback toggle-midi-device(/* input */ int, /* device name */ string);
    // Makes the slot listen to the input, or stop listening.
    callback toggle-slot-input(/* slot */ int, /* input */ int);
    // Refills `AppState.picker-rows` with `category`'s plugins matching `query`.
    callback filter-picker(/* category */ int, /* query */ string);
    callback toggle-pin(/* plugin id */ string);
    // Loads the plugin as the slot's instrument (replacing any) or appends it
    // to the slot's MIDI or audio effects, depending on `category`.
    callback pick-plugin(/* slot */ int, /* category */ int, /* plugin id */ string);
    // The sample download offered by `download-state`: start (or retry) it,
    // or cancel it / close the dialog.
    callback start-download();
    callback cancel-download();
    callback unload-plugin(/* slot */ int);
    // Removes every plugin from the slot, keeping what was there for
    // `undo-clear` (shown through `SlotState.closed-name`).
    callback clear-slot(/* slot */ int);
    // Puts back what `clear-slot` removed: the chain, its settings, routing and
    // volume.
    callback undo-clear(/* slot */ int);
    // Forgets what `clear-slot` removed, leaving the slot empty.
    callback dismiss-closed(/* slot */ int);
    callback toggle-slot-mute(/* slot */ int);
    callback set-slot-transpose(/* slot */ int, /* semitones */ int);
    callback remove-effect(/* slot */ int, /* section */ int, /* index */ int);
    callback move-effect(/* slot */ int, /* section */ int, /* from */ int, /* to */ int);
    // Opens `key`'s parameter window, or closes it if open.
    callback toggle-params(/* key */ int);
    // An effect's square clicked with nothing open: its own GUI, or its
    // parameter window if it has none or the GUI fails to open.
    callback open-effect(/* key */ int);
    callback open-plugin-gui(/* key */ int);
    callback close-plugin-gui(/* key */ int);
    // Invoked by the Rust side for a `ParamsWindow`'s edits (a separate window
    // can't reach this window's globals itself).
    callback set-param(/* key */ int, /* param-id */ int, float);
    // Presets. The browser's actions act on `AppState.preset-browser-key`'s
    // plugin; `index` is into `AppState.preset-rows`.
    callback open-preset-browser(/* key */ int);
    callback close-preset-browser();
    // Shows the presets whose name contains every word of `query`.
    callback filter-presets(/* query */ string);
    // Loads the preset and closes the browser.
    callback load-preset(/* index */ int);
    // Adds the preset to the favourites, or removes it.
    callback toggle-preset-pin(/* index */ int);
    callback save-preset(/* key */ int, /* name */ string);
    // Deletes the plugin's current preset.
    callback delete-preset(/* key */ int);
    // Slot presets. Choosing a folder row opens it; choosing a preset loads it.
    callback choose-slot-preset(/* slot */ int, /* index into slot-preset-rows */ int);
    // Back from a folder to the list of folders.
    callback show-slot-preset-folders(/* slot */ int);
    callback save-slot-preset(/* slot */ int, /* name */ string);
    // Deletes the slot's current slot preset.
    callback delete-slot-preset(/* slot */ int);
    // Channel uses the same encoding as `SlotState.midi-channel`.
    callback set-slot-filter(/* slot */ int, /* channel */ int, /* note-low */ int, /* note-high */ int, /* velocity-low */ int, /* velocity-high */ int);
    callback set-slot-volume(/* slot */ int, /* dB */ float);
    // Which tab a slot shows (0 the panel and audio effects, 2 MIDI), so only
    // visible effects' inline displays are rendered.
    callback set-slot-tab(/* slot */ int, /* tab */ int);
    // The instrument panel on a slot's first tab. `cell` indexes
    // `SlotState.cells`, `drawbar` `SlotState.drawbars`. A cell's value: a
    // knob's position, a switch's state, or a lever's or stepped knob's option.
    callback set-cell-position(/* slot */ int, /* cell */ int, /* 0..1 */ float);
    callback set-cell-on(/* slot */ int, /* cell */ int, bool);
    callback set-cell-index(/* slot */ int, /* cell */ int, /* option */ int);
    callback set-drawbar(/* slot */ int, /* drawbar */ int, /* level 0..=8 */ int);
    // Shows pool control `pool-index` (into `SlotState.pool`) in the cell; kept
    // per plugin, so every slot with this instrument follows.
    callback set-panel-cell(/* slot */ int, /* cell */ int, /* pool-index */ int);
    // Puts the instrument's row back to its profile's default.
    callback reset-panel-row(/* slot */ int);
    // "More parameters…": starts a search over the slot's instrument's
    // parameters for the cell (`AppState.param-search-rows`), narrows it, and
    // shows the parameter at `index` in the cell.
    callback open-param-search(/* slot */ int, /* cell */ int);
    callback filter-param-search(/* query */ string);
    callback pick-param-search(/* index */ int);
    // Scenes. `index` is into `AppState.scene-rows`; -1 means the current scene.
    callback filter-scenes(/* query */ string);
    callback load-scene(/* index */ int);
    // Fills the form's slot modes: the current scene's, else restore for
    // every slot with plugins and leave unchanged for the others.
    callback begin-scene-save();
    // Makes the scene the one to edit, and fills the form from it.
    callback begin-scene-edit(/* index */ int);
    // Makes the scene the one to delete.
    callback begin-scene-delete(/* index */ int);
    callback set-scene-slot-mode(/* slot */ int, /* mode */ int);
    callback save-scene(/* name */ string);
    // Saves the slots' current setups over the scene, keeping its slot modes.
    callback overwrite-scene(/* index */ int);
    // Renames the scene being edited and gives it the form's slot modes.
    callback edit-scene(/* name */ string);
    callback delete-scene();
    // Copies the scene as "<name> copy", right after it.
    callback duplicate-scene(/* index */ int);
    // Moves the scene at row `from` to row `to`.
    callback move-scene(/* from */ int, /* to */ int);
    // The right sidebar: master output, metronome, MIDI panic, Settings.
    callback set-master-volume(/* dB */ float);
    callback toggle-master-mute();
    callback set-master-transpose(/* semitones */ int);
    callback toggle-metronome();
    callback set-metronome-bpm(int);
    // A tap on Tap: after a few, the tempo follows the taps.
    callback tap-tempo();
    callback set-metronome-volume(/* 0..1 */ float);
    callback set-metronome-signature(/* index */ int);
    callback set-metronome-subdivision(/* index */ int);
    // All notes off and controllers reset, on every slot and channel.
    callback midi-panic();
    // Opens the Settings window (plugin folders and scanning).
    callback open-settings();
}
