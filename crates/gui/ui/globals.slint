export struct PluginRow {
    // `PluginInfo::id`: an LV2 URI or `vst3:` + class ID.
    id: string,
    name: string,
}

export struct ParamRow {
    param-id: int,
    name: string,
    min-value: float,
    max-value: float,
    // Last value sent to the plugin (from a slider or the plugin's own GUI), so a
    // rebuilt slider shows where the parameter actually is, not its default.
    value: float,
}

// One rack slot on the Live tab.
export struct SlotState {
    // Empty when nothing is loaded into this slot.
    plugin-name: string,
    // Whether the loaded plugin has any GUI this host can show at all.
    gui-supported: bool,
    // Whether we currently believe a plugin GUI session is open. A plugin's own UI
    // can wedge internally (observed with some External UI plugins) and never
    // signal back that it closed — "Close GUI" lets the user force this back to
    // false so they can at least try a fresh session, independent of whatever the
    // previous one's hosting thread is stuck doing.
    gui-open: bool,
    // Why the GUI can't be opened, or the last load/open error; empty if none.
    status: string,
    // Parameters of the loaded plugin — a parameter editor usable whether or not
    // the plugin has its own GUI.
    params: [ParamRow],
    // MIDI this slot responds to. Channel is 0 for omni, else 1-16; note and
    // velocity ranges are inclusive.
    midi-channel: int,
    note-low: int,
    note-high: int,
    velocity-low: int,
    velocity-high: int,
    volume-db: float,
}

// State the host (Rust) pushes into the UI.
export global AppState {
    in property <[string]> audio-devices;
    // ComboBox writes to `current-value` don't update its visual selection
    // (https://github.com/slint-ui/slint/issues/11970) — drive it by index instead.
    in property <int> selected-audio-index: -1;
    in property <[string]> midi-ports;
    in property <int> selected-midi-index: -1;
    in property <[string]> default-plugin-folders;
    in property <[string]> extra-plugin-folders;
    in property <[PluginRow]> plugins;
    // `plugins[i]`'s display name (with its format) for every i, since a ComboBox
    // model must be `[string]`.
    in property <[string]> plugin-names;
    in property <[SlotState]> slots;
    // Volume fader range; the minimum means muted.
    in property <float> min-volume-db: -60;
    in property <float> max-volume-db: 6;
}

// Actions the UI triggers that the host (Rust) handles. `slot` arguments index
// `AppState.slots`.
export global AppLogic {
    callback select-audio-device(string);
    callback select-midi-port(string);
    callback add-plugin-folder();
    callback remove-plugin-folder(string);
    callback rescan-plugins();
    callback load-plugin(/* slot */ int, /* plugin id */ string);
    callback unload-plugin(/* slot */ int);
    callback open-plugin-gui(/* slot */ int);
    callback close-plugin-gui(/* slot */ int);
    callback set-param(/* slot */ int, /* param-id */ int, float);
    // Channel uses the same encoding as `SlotState.midi-channel`.
    callback set-slot-filter(/* slot */ int, /* channel */ int, /* note-low */ int, /* note-high */ int, /* velocity-low */ int, /* velocity-high */ int);
    callback set-slot-volume(/* slot */ int, /* dB */ float);
}
