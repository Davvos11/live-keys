// One plugin in the plugin picker's list.
export struct PickerRow {
    // `PluginInfo::id`: an LV2 URI or `vst3:` + class ID.
    id: string,
    name: string,
    // "LV2" or "VST3".
    format: string,
    pinned: bool,
    // The first unpinned row after some pinned ones, drawn with a divider above.
    after-pinned: bool,
}

export struct ParamRow {
    param-id: int,
    name: string,
    // As `ParamKind`: 0 continuous, 1 toggle, 2 stepped, 3 choice, 4 note.
    kind: int,
    min-value: float,
    max-value: float,
    // Steps between min and max for stepped/note parameters; 0 otherwise.
    steps: int,
    // Continuous parameter shown on a logarithmic slider (min-value > 0).
    logarithmic: bool,
    // Last value sent to the plugin (from a control or the plugin's own GUI), so
    // a rebuilt control shows where the parameter actually is, not its default.
    value: float,
    // `value` as the plugin or its metadata would show it ("-6 dB", "C#3").
    text: string,
    // A choice parameter's option labels, their values, and the current one.
    choices: [string],
    choice-values: [float],
    choice-index: int,
}

// One preset in the preset browser.
export struct PresetRow {
    name: string,
    // Saved by the user (and so deletable).
    user: bool,
    // A favourite, listed first.
    pinned: bool,
    // The first non-favourite row after some favourites, drawn with a divider above.
    after-pinned: bool,
    // The preset last loaded or saved.
    current: bool,
}

// One plugin (an instrument or a MIDI or audio effect) in a slot's chain.
export struct EffectRow {
    // The engine's `PluginKey` of this instance, or -1 for no plugin.
    key: int,
    name: string,
    // Whether the plugin has any GUI this host can show at all.
    gui-supported: bool,
    // Whether we currently believe the plugin's GUI session is open. A plugin's
    // own UI can wedge internally (observed with some External UI plugins) and
    // never signal back that it closed — "GUI" lets the user force this back to
    // false so they can at least try a fresh session, independent of whatever
    // the previous one's hosting thread is stuck doing.
    gui-open: bool,
    // Whether its parameter window is open.
    params-open: bool,
    // The preset last loaded or saved; empty if none.
    preset-name: string,
    // Whether that preset was saved by the user (and so can be deleted).
    preset-user: bool,
    // Whether a parameter changed since that preset was loaded or saved.
    preset-changed: bool,
}

// One rack slot on the Live tab: MIDI effects, an instrument, then audio
// effects.
export struct SlotState {
    // Its key is -1 when no instrument is loaded into this slot.
    instrument: EffectRow,
    // The last load/open/preset error; empty if none.
    status: string,
    // In processing order, in front of the instrument.
    midi-effects: [EffectRow],
    // In processing order, after the instrument.
    audio-effects: [EffectRow],
    // MIDI this slot responds to. Channel is 0 for omni, else 1-16; note and
    // velocity ranges are inclusive.
    midi-channel: int,
    note-low: int,
    note-high: int,
    velocity-low: int,
    velocity-high: int,
    volume-db: float,
}

// State the host (Rust) pushes into the UI.
export global AppState {
    in property <[string]> audio-devices;
    // ComboBox writes to `current-value` don't update its visual selection
    // (https://github.com/slint-ui/slint/issues/11970) — drive it by index instead.
    in property <int> selected-audio-index: -1;
    in property <[string]> midi-ports;
    in property <int> selected-midi-index: -1;
    in property <[string]> default-plugin-folders;
    in property <[string]> extra-plugin-folders;
    // Every plugin found, as "name — kind (format)", for the Settings tab.
    in property <[string]> discovered-plugins;
    // The plugin picker's list for its current category and search, pinned
    // plugins first; refilled by `AppLogic.filter-picker`.
    in property <[PickerRow]> picker-rows;
    in property <int> max-midi-effects: 8;
    in property <int> max-effects: 8;
    in property <[SlotState]> slots;
    // Volume fader range; the minimum means muted.
    in property <float> min-volume-db: -60;
    in property <float> max-volume-db: 6;
    // The plugin whose preset browser is open, or -1; one at a time.
    in property <int> preset-browser-key: -1;
    // Its presets matching `preset-query`, favourites first, and how many
    // presets it has in all.
    in property <[PresetRow]> preset-rows;
    in property <int> preset-count;
    in property <string> preset-query;
}

// Plugin categories, as the picker's tabs and `category` arguments number them.
export global Category {
    out property <int> instrument: 0;
    out property <int> midi-effect: 1;
    out property <int> audio-effect: 2;
}

// Actions the UI triggers that the host (Rust) handles. `slot` arguments index
// `AppState.slots`; `key` arguments are a loaded plugin's `PluginKey`;
// `category` is as in `Category`; `section` is 0 for a slot's MIDI effects and
// 1 for its audio effects.
export global AppLogic {
    callback select-audio-device(string);
    callback select-midi-port(string);
    callback add-plugin-folder();
    callback remove-plugin-folder(string);
    callback rescan-plugins();
    // Refills `AppState.picker-rows` with `category`'s plugins matching `query`.
    callback filter-picker(/* category */ int, /* query */ string);
    callback toggle-pin(/* plugin id */ string);
    // Loads the plugin as the slot's instrument (replacing any) or appends it
    // to the slot's MIDI or audio effects, depending on `category`.
    callback pick-plugin(/* slot */ int, /* category */ int, /* plugin id */ string);
    callback unload-plugin(/* slot */ int);
    callback remove-effect(/* slot */ int, /* section */ int, /* index */ int);
    callback move-effect(/* slot */ int, /* section */ int, /* from */ int, /* to */ int);
    // Opens `key`'s parameter window, or closes it if open.
    callback toggle-params(/* key */ int);
    callback open-plugin-gui(/* key */ int);
    callback close-plugin-gui(/* key */ int);
    // Invoked by the Rust side for a `ParamsWindow`'s edits (a separate window
    // can't reach this window's globals itself).
    callback set-param(/* key */ int, /* param-id */ int, float);
    // Presets. The browser's actions act on `AppState.preset-browser-key`'s
    // plugin; `index` is into `AppState.preset-rows`.
    callback open-preset-browser(/* key */ int);
    callback close-preset-browser();
    // Shows the presets whose name contains every word of `query`.
    callback filter-presets(/* query */ string);
    // Loads the preset and closes the browser.
    callback load-preset(/* index */ int);
    // Adds the preset to the favourites, or removes it.
    callback toggle-preset-pin(/* index */ int);
    callback save-preset(/* key */ int, /* name */ string);
    // Deletes the plugin's current preset.
    callback delete-preset(/* key */ int);
    // Channel uses the same encoding as `SlotState.midi-channel`.
    callback set-slot-filter(/* slot */ int, /* channel */ int, /* note-low */ int, /* note-high */ int, /* velocity-low */ int, /* velocity-high */ int);
    callback set-slot-volume(/* slot */ int, /* dB */ float);
}
