import { AppLogic, SlotPresetRow, SlotState } from "globals.slint";
import { Theme, Icons, Icon, KButton, ListItem, TextField } from "widgets.slint";

// A slot's presets (its second tab): the current slot preset (greyed "changed"
// once the chain or a parameter changed since it was loaded or saved), saving
// and deleting it, and the slot presets grouped by instrument — the loaded
// instrument's folder open, or every folder when there's no instrument.
// Clicking a preset loads it straight away.
export component SlotPresets inherits VerticalLayout {
    in property <int> slot-index;
    in property <SlotState> slot;

    // 0: browsing, 1: naming a preset to save, 2: confirming a delete.
    property <int> mode: 0;

    spacing: 6px;

    if root.mode == 0 : HorizontalLayout {
        spacing: 4px;
        Text {
            text: root.slot.slot-preset-name != "" ? root.slot.slot-preset-name : "No slot preset";
            color: root.slot.slot-preset-name != "" ? Theme.text : Theme.text-faint;
            font-size: Theme.font-size;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.slot.slot-preset-changed : Text {
            text: "changed";
            color: Theme.text-faint;
            font-size: Theme.small-font-size;
            vertical-alignment: center;
        }
        KButton {
            icon: Icons.save;
            text: "Save…";
            clicked => { root.mode = 1; }
        }
        KButton {
            icon: Icons.trash;
            enabled: root.slot.slot-preset-name != "";
            clicked => { root.mode = 2; }
        }
    }

    if root.mode == 1 : HorizontalLayout {
        spacing: 4px;
        name := TextField {
            horizontal-stretch: 1;
            placeholder: "Slot preset name";
            // Saving over the current preset is the common case.
            text: root.slot.slot-preset-name;
            init => { self.grab-focus(); }
            accepted(text) => {
                if (text != "") {
                    AppLogic.save-slot-preset(root.slot-index, text);
                    root.mode = 0;
                }
            }
        }
        KButton {
            text: "Save";
            active: true;
            enabled: name.text != "";
            clicked => {
                AppLogic.save-slot-preset(root.slot-index, name.text);
                root.mode = 0;
            }
        }
        KButton {
            icon: Icons.close;
            clicked => { root.mode = 0; }
        }
    }

    if root.mode == 2 : HorizontalLayout {
        spacing: 4px;
        Text {
            text: "Delete \"\{root.slot.slot-preset-name}\"?";
            color: Theme.text;
            font-size: Theme.small-font-size;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        KButton {
            text: "Delete";
            active: true;
            clicked => {
                AppLogic.delete-slot-preset(root.slot-index);
                root.mode = 0;
            }
        }
        KButton {
            icon: Icons.close;
            clicked => { root.mode = 0; }
        }
    }

    // Which folder is shown, with a way back to all of them.
    HorizontalLayout {
        spacing: 2px;
        height: 24px;
        if root.slot.slot-preset-folder != "" : Rectangle {
            width: 24px;
            border-radius: Theme.radius;
            background: back-area.has-hover ? Theme.control-hover : transparent;
            Icon {
                width: 18px;
                height: 18px;
                source: Icons.chevron-left;
            }
            back-area := TouchArea {
                mouse-cursor: pointer;
                clicked => { AppLogic.show-slot-preset-folders(root.slot-index); }
            }
        }
        Text {
            text: root.slot.slot-preset-folder != "" ? root.slot.slot-preset-folder : "All instruments";
            color: Theme.text-faint;
            font-size: Theme.small-font-size;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }

    if root.slot.slot-preset-rows.length == 0 : Text {
        text: root.slot.slot-preset-folder != "" ? "No slot presets for this instrument yet." : "No slot presets yet.";
        color: Theme.text-faint;
        font-size: Theme.small-font-size;
        wrap: word-wrap;
    }
    for row[index] in root.slot.slot-preset-rows : ListItem {
        text: row.name;
        selected: row.current;
        note: row.folder ? "\{row.count}" : "";
        clicked => { AppLogic.choose-slot-preset(root.slot-index, index); }
        if row.folder : VerticalLayout {
            alignment: center;
            Icon {
                width: 18px;
                height: 18px;
                source: Icons.chevron-right;
            }
        }
    }
}
