// The control surfaces panel at the bottom of the window (Penpot: "MIDI learn
// 1"): the MIDI devices shown, each drawn as its surface's banks of faders,
// knobs, pads and buttons, moving as the hardware does. See
// `docs/design/midi-learn.md`.
import { CheckBox, ScrollView } from "std-widgets.slint";
import { AppState, AppLogic, SurfaceView, SurfaceControlView } from "globals.slint";
import { Theme, Icons, KButton, DropdownButton, ListItem, Segmented, Stepper, TextField } from "widgets.slint";
import { PopupFrame } from "slot_panel.slint";

export global SurfaceSizes {
    // The panel expanded, and collapsed to one row.
    out property <length> expanded: 140px;
    out property <length> collapsed: 44px;
    // The left column, as wide as the scenes pane above it.
    out property <length> column: 300px;

    // A value's colour: the primary colour once it drives something.
    public pure function value-colour(mapped: bool) -> brush {
        return mapped ? Theme.accent : Theme.text-faint;
    }
}

component ControlLabel inherits Text {
    font-size: Theme.tiny-font-size;
    color: Theme.text-faint;
    horizontal-alignment: center;
}

// The fader's cell is 28×100 unless its bank says otherwise (the track
// follows its height). While its target is elsewhere (MIDI learn's pick-up or
// glide), the cap is drawn at the target, and the hardware's position as a
// ghost.
component SurfaceFader inherits Rectangle {
    in property <SurfaceControlView> control;
    property <length> track: root.height - 30px;
    property <length> middle: root.width / 2;
    property <float> shown: root.control.waiting ? root.control.target : root.control.value;

    Rectangle {
        x: root.middle - 2px;
        y: 6px;
        width: 4px;
        height: root.track;
        border-radius: 2px;
        background: Theme.control-border;
    }
    Rectangle {
        x: root.middle - 2px;
        y: 6px + root.track * (1 - root.shown);
        width: 4px;
        height: root.track * root.shown;
        border-radius: 2px;
        background: SurfaceSizes.value-colour(root.control.mapped);
    }
    if root.control.waiting : Rectangle {
        x: root.middle - 9px;
        y: 2px + root.track * (1 - root.control.value);
        width: 18px;
        height: 8px;
        border-radius: 2px;
        border-width: 1px;
        border-color: Theme.text-muted;
        background: Theme.text-muted.with-alpha(0.15);
    }
    Rectangle {
        x: root.middle - 9px;
        y: 2px + root.track * (1 - root.shown);
        width: 18px;
        height: 8px;
        border-radius: 2px;
        background: root.control.moving || root.control.waiting ? Theme.text : Theme.text-muted;
    }
    ControlLabel {
        y: root.height - self.height - 2px;
        width: root.width;
        text: root.control.label;
    }
}

// The knob's cell is 44×54 unless its bank says otherwise (the dial shrinks
// in a lower one). While its target is elsewhere, the pointer shows the
// target, and a ghost dot the hardware's position.
component SurfaceKnob inherits Rectangle {
    in property <SurfaceControlView> control;
    property <angle> start: -135deg;
    property <float> shown: root.control.waiting ? root.control.target : root.control.value;
    property <angle> end: self.start + 270deg * root.shown;
    property <angle> ghost: self.start + 270deg * root.control.value;

    // An SVG arc on a circle of radius 40 around (50, 50), clockwise.
    function arc(from: angle, to: angle) -> string {
        let large = to - from > 180deg ? 1 : 0;
        return "M \{50 + 40 * Math.sin(from)} \{50 - 40 * Math.cos(from)} A 40 40 0 \{large} 1 \{50 + 40 * Math.sin(to)} \{50 - 40 * Math.cos(to)}";
    }

    dial := Rectangle {
        width: min(32px, root.height - 16px);
        height: self.width;
        x: (root.width - self.width) / 2;
        y: 3px;
        Path {
            width: 100%;
            height: 100%;
            viewbox-width: 100;
            viewbox-height: 100;
            commands: arc(-135deg, 135deg);
            stroke: Theme.control-border;
            stroke-width: 3px;
            stroke-line-cap: round;
        }
        if root.shown > 0.004 : Path {
            width: 100%;
            height: 100%;
            viewbox-width: 100;
            viewbox-height: 100;
            commands: arc(root.start, root.end);
            stroke: SurfaceSizes.value-colour(root.control.mapped);
            stroke-width: 3px;
            stroke-line-cap: round;
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 20px;
            height: 20px;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.control-border;
            background: root.control.moving ? Theme.control-hover : Theme.control;
        }
        Path {
            width: 100%;
            height: 100%;
            viewbox-width: 100;
            viewbox-height: 100;
            commands: "M \{50 + 8 * Math.sin(root.end)} \{50 - 8 * Math.cos(root.end)} L \{50 + 28 * Math.sin(root.end)} \{50 - 28 * Math.cos(root.end)}";
            stroke: Theme.text;
            stroke-width: 2px;
            stroke-line-cap: round;
        }
        if root.control.waiting : Rectangle {
            x: parent.width / 2 + parent.width * 0.4 * Math.sin(root.ghost) - 3px;
            y: parent.height / 2 - parent.height * 0.4 * Math.cos(root.ghost) - 3px;
            width: 6px;
            height: 6px;
            border-radius: 3px;
            border-width: 1px;
            border-color: Theme.text;
            background: Theme.background;
        }
    }
    ControlLabel {
        y: root.height - self.height - 2px;
        width: root.width;
        text: root.control.label;
    }
}

// The pad's cell is 44×44; lit while held, brighter the harder.
component SurfacePad inherits Rectangle {
    in property <SurfaceControlView> control;

    Rectangle {
        x: 3px;
        y: 3px;
        width: root.width - 6px;
        height: root.height - 6px;
        border-radius: 4px;
        border-width: 1px;
        border-color: root.control.mapped ? Theme.accent : Theme.control-border;
        background: root.control.pressed ? Theme.accent.with-alpha(0.35 + 0.65 * root.control.value) : Theme.control;
        Text {
            x: 4px;
            y: parent.height - self.height - 2px;
            text: root.control.label;
            font-size: Theme.tiny-font-size;
            color: root.control.pressed ? Theme.on-accent : Theme.text-faint;
        }
    }
}

// The button's cell is 36×38.
component SurfaceButton inherits Rectangle {
    in property <SurfaceControlView> control;

    Rectangle {
        x: 5px;
        y: 4px;
        width: root.width - 10px;
        height: 14px;
        border-radius: 3px;
        border-width: 1px;
        border-color: root.control.mapped ? Theme.accent : Theme.control-border;
        background: root.control.pressed ? Theme.accent : Theme.control;
    }
    ControlLabel {
        y: root.height - self.height - 2px;
        width: root.width;
        text: root.control.label;
    }
}

// One device: its name over its surface, or a note that there's none.
component SurfaceDrawing inherits Rectangle {
    in property <SurfaceView> surface;
    property <length> name-height: 18px;

    width: root.surface.known ? max(root.surface.width * 1px, name.preferred-width + 40px) : 420px;

    name := Text {
        x: 0;
        y: 0;
        height: root.name-height;
        text: root.surface.connected ? root.surface.name : root.surface.name + " (not connected)";
        font-size: Theme.tiny-font-size;
        font-weight: 600;
        color: Theme.text-faint;
        vertical-alignment: center;
    }
    // Opens the surface editor.
    if root.surface.known : Text {
        x: name.preferred-width + 8px;
        y: 0;
        height: root.name-height;
        text: "Edit";
        font-size: Theme.tiny-font-size;
        color: edit-area.has-hover ? Theme.accent : Theme.text-faint;
        vertical-alignment: center;
        edit-area := TouchArea {
            mouse-cursor: pointer;
            clicked => { AppLogic.edit-surface(root.surface.device, false); }
        }
    }
    // Its pages, the shown one highlighted; clicking one shows it.
    if root.surface.known && (root.surface.pages.length > 0 || root.surface.driver != "") : HorizontalLayout {
        x: name.preferred-width + 40px;
        y: 0;
        height: root.name-height;
        spacing: 8px;
        alignment: start;
        for page[index] in root.surface.pages : Text {
            text: page;
            font-size: Theme.tiny-font-size;
            font-weight: index == root.surface.page ? 600 : 400;
            color: index == root.surface.page ? Theme.accent : page-area.has-hover ? Theme.text : Theme.text-faint;
            vertical-alignment: center;
            page-area := TouchArea {
                mouse-cursor: pointer;
                clicked => { AppLogic.surface-page(root.surface.device, index); }
            }
        }
        // The page's variant (the keyboard's preset): click for the next,
        // right-click for the previous.
        if root.surface.variant != "" : Text {
            text: "◂ " + root.surface.variant + " ▸";
            font-size: Theme.tiny-font-size;
            color: variant-area.has-hover ? Theme.text : Theme.text-faint;
            vertical-alignment: center;
            variant-area := TouchArea {
                mouse-cursor: pointer;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        if event.button == PointerEventButton.left {
                            AppLogic.surface-variant(root.surface.device, 1);
                        } else if event.button == PointerEventButton.right {
                            AppLogic.surface-variant(root.surface.device, -1);
                        }
                    }
                }
            }
        }
        // The driver's switch: "DAW mode" on or off.
        if root.surface.driver != "" : Text {
            text: root.surface.driver + (root.surface.driver-on ? " on" : " off");
            font-size: Theme.tiny-font-size;
            font-weight: root.surface.driver-on ? 600 : 400;
            color: root.surface.driver-on ? Theme.accent : driver-area.has-hover ? Theme.text : Theme.text-faint;
            vertical-alignment: center;
            driver-area := TouchArea {
                mouse-cursor: pointer;
                clicked => { AppLogic.toggle-surface-driver(root.surface.device); }
            }
        }
    }
    if root.surface.known : Rectangle {
        y: root.name-height;
        width: root.surface.width * 1px;
        height: root.surface.height * 1px;
        opacity: root.surface.connected ? 1 : 0.4;
        for control[index] in root.surface.controls : Rectangle {
            x: control.x * 1px;
            y: control.y * 1px;
            width: control.width * 1px;
            height: control.height * 1px;
            visible: !control.hidden;
            border-radius: 4px;
            border-width: control.selected ? 2px : area.has-hover ? 1px : 0px;
            border-color: control.selected ? Theme.accent : Theme.control-border;
            if control.kind == 0 : SurfaceFader { control: control; }
            if control.kind == 1 : SurfaceKnob { control: control; }
            if control.kind == 2 : SurfacePad { control: control; }
            if control.kind == 3 : SurfaceButton { control: control; }
            // Clicking a control learns it (MIDI learn).
            area := TouchArea {
                mouse-cursor: pointer;
                clicked => { AppLogic.learn-select(root.surface.device, index); }
            }
        }
    }
    if !root.surface.known : Rectangle {
        y: root.name-height + 4px;
        height: 96px;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.control-border;
        background: Theme.control;
        VerticalLayout {
            padding: 10px;
            spacing: 8px;
            Text {
                text: "No control surface is known for this device yet.";
                color: Theme.text-muted;
                font-size: Theme.small-font-size;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 6px;
                KButton {
                    text: "Learn by moving controls";
                    active: true;
                    clicked => { AppLogic.edit-surface(root.surface.device, true); }
                }
                KButton {
                    text: "Lay out…";
                    clicked => { AppLogic.edit-surface(root.surface.device, false); }
                }
                KButton {
                    text: "Hide";
                    clicked => { AppLogic.toggle-surface-device(root.surface.device); }
                }
            }
        }
    }
}

// The devices shown: a button summarising them that opens a checklist of every
// device (as a MIDI input's).
component SurfaceDevices inherits Rectangle {
    height: Theme.control-height;

    devices := DropdownButton {
        width: 100%;
        text: AppState.surface-summary;
        placeholder: "Choose devices…";
        open: popup.is-open;
        clicked => { popup.show(); }
    }

    popup := PopupWindow {
        x: 0;
        // Opens upwards: the panel is at the bottom of the window.
        y: -self.height - 2px;
        width: root.width;
        close-policy: PopupClosePolicy.close-on-click-outside;

        PopupFrame {
            VerticalLayout {
                padding: 6px;
                spacing: 2px;
                for device in AppState.surface-devices : CheckBox {
                    text: device.available ? device.name : device.name + " (not connected)";
                    checked: device.checked;
                    // Clicking sets `checked` itself, replacing the binding above.
                    property <bool> source: device.checked;
                    changed source => { self.checked = self.source; }
                    toggled => { AppLogic.toggle-surface-device(device.name); }
                }
                if AppState.surface-devices.length == 0 : Text {
                    text: "No MIDI devices found";
                    color: Theme.text-faint;
                }
            }
        }
    }
}

// The panel. `expanded`: the full panel, else one row. `overlay`: it's shown
// over the slots (the window is too short to make room), so its button closes
// it rather than collapsing it.
export component SurfacesPanel inherits Rectangle {
    in property <bool> expanded;
    in property <bool> overlay;
    // The button at the top right of the left column (or the row's end).
    callback toggle();

    background: Theme.background;

    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.divider;
    }

    if !root.expanded : HorizontalLayout {
        padding: 6px;
        padding-left: 10px;
        spacing: 10px;
        Text {
            text: "Control surfaces";
            color: Theme.text-muted;
            font-size: Theme.font-size;
            font-weight: 600;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            // Lit while a shown device sends something.
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: AppState.surface-activity ? Theme.accent : Theme.control-border;
            }
        }
        SurfaceDevices {
            width: 280px;
        }
        KButton {
            text: "MIDI learn";
            active: AppState.learning;
            clicked => { AppLogic.set-learning(!AppState.learning); }
        }
        Rectangle { horizontal-stretch: 1; }
        KButton {
            icon: Icons.chevron-up;
            clicked => { root.toggle(); }
        }
    }

    if root.expanded : HorizontalLayout {
        // The left column.
        Rectangle {
            width: SurfaceSizes.column;
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.divider;
            }
            VerticalLayout {
                padding: 10px;
                padding-top: 6px;
                spacing: 8px;
                HorizontalLayout {
                    Text {
                        horizontal-stretch: 1;
                        text: "Control surfaces";
                        color: Theme.text-muted;
                        font-size: Theme.font-size;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    KButton {
                        icon: root.overlay ? Icons.close : Icons.chevron-down;
                        clicked => { root.toggle(); }
                    }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    KButton {
                        text: "MIDI learn";
                        active: AppState.learning;
                        clicked => { AppLogic.set-learning(!AppState.learning); }
                    }
                }
                SurfaceDevices { }
            }
        }
        // The surfaces, side by side, scrolling sideways when they don't fit.
        Rectangle {
            horizontal-stretch: 1;
            clip: true;
            // Mouse wheels scroll sideways. Under the surfaces, so their
            // controls get clicks; wheel events they don't take come here.
            TouchArea {
                scroll-event(event) => {
                    if (flick.content-width <= flick.width) {
                        return reject;
                    }
                    let delta = event.delta-x != 0 ? event.delta-x : event.delta-y;
                    flick.content-x = Math.clamp(flick.content-x + delta, flick.width - flick.content-width, 0);
                    accept
                }
            }
            flick := Flickable {
                content-width: row.preferred-width;
                row := HorizontalLayout {
                    padding: 12px;
                    padding-top: 6px;
                    spacing: 16px;
                    alignment: start;
                    for surface[index] in AppState.surfaces : HorizontalLayout {
                        spacing: 16px;
                        if index > 0 : Rectangle {
                            width: 1px;
                            background: Theme.divider;
                        }
                        SurfaceDrawing { surface: surface; }
                    }
                    if AppState.surfaces.length == 0 : Text {
                        text: "Choose the MIDI devices to show here: their knobs, faders and pads, as you move them.";
                        color: Theme.text-faint;
                        font-size: Theme.small-font-size;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

component EditCaption inherits Text {
    color: Theme.text-muted;
    font-size: Theme.small-font-size;
    vertical-alignment: center;
}

// A number setting: its name, then a stepper.
component EditNumber inherits HorizontalLayout {
    in property <string> label;
    in property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 127;
    callback changed(int);

    spacing: 6px;
    EditCaption {
        text: root.label;
        horizontal-stretch: 1;
    }
    Stepper {
        signed: false;
        minimum: root.minimum;
        maximum: root.maximum;
        value: root.value;
        // Stepping sets its own value, replacing the binding.
        property <int> source: root.value;
        changed source => { self.value = self.source; }
        changed(value) => { root.changed(value); }
    }
}

// The surface editor (Penpot: "MIDI learn 4"), over the slots: the surface's
// and the selected bank's settings on the left, the surface on the right with
// its banks framed — a bank's handle selects and drags it, a control clicked
// is learned on its own.
export component SurfaceEditor inherits Rectangle {
    property <length> handle: 14px;

    background: Theme.background;

    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.divider;
    }

    HorizontalLayout {
        // The settings.
        Rectangle {
            width: SurfaceSizes.column;
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.divider;
            }
            settings := ScrollView {
                VerticalLayout {
                    width: settings.visible-width;
                    padding: 10px;
                    spacing: 8px;
                    alignment: start;
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: "Edit surface";
                            color: Theme.text;
                            font-size: Theme.font-size;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        KButton {
                            text: "Cancel";
                            clicked => { AppLogic.edit-finish(false); }
                        }
                        KButton {
                            text: "Save";
                            active: true;
                            clicked => { AppLogic.edit-finish(true); }
                        }
                    }
                    TextField {
                        text: AppState.edit-name;
                        placeholder: "Name";
                        edited(text) => { AppLogic.edit-set-name(text); }
                    }
                    Text {
                        text: "For " + AppState.edit-device;
                        color: Theme.text-faint;
                        font-size: Theme.small-font-size;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        add := KButton {
                            text: "+ Add";
                            clicked => { add-menu.show(); }
                        }
                        KButton {
                            text: AppState.edit-listening == 3 ? "Stop learning" : "Learn controls…";
                            active: AppState.edit-listening == 3;
                            clicked => {
                                if (AppState.edit-listening == 3) {
                                    AppLogic.edit-stop();
                                } else {
                                    AppLogic.edit-learn(3);
                                }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    if AppState.edit-status != "" : Text {
                        text: AppState.edit-status;
                        color: AppState.edit-listening > 0 ? Theme.accent : Theme.text-muted;
                        font-size: Theme.small-font-size;
                        wrap: word-wrap;
                    }
                    if AppState.edit-listening == 1 || AppState.edit-listening == 2 : HorizontalLayout {
                        spacing: 6px;
                        if AppState.edit-listening == 1 : KButton {
                            text: "Skip";
                            clicked => { AppLogic.edit-skip(); }
                        }
                        KButton {
                            text: "Stop";
                            clicked => { AppLogic.edit-stop(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    if AppState.edit-selected < 0 : Text {
                        text: AppState.edit-banks.length == 0
                            ? "Add banks of faders, knobs, pads or buttons, or let \"Learn controls…\" make them as you move each control."
                            : "Click a bank's handle to set it up; drag it to move it.";
                        color: Theme.text-faint;
                        font-size: Theme.small-font-size;
                        wrap: word-wrap;
                    }
                    if AppState.edit-selected >= 0 : VerticalLayout {
                        spacing: 8px;
                        Rectangle {
                            height: 1px;
                            background: Theme.divider;
                        }
                        TextField {
                            text: AppState.edit-bank.name;
                            placeholder: "Bank name";
                            edited(text) => { AppLogic.edit-bank-name(text); }
                        }
                        Segmented {
                            options: ["Faders", "Knobs", "Pads", "Buttons"];
                            current: AppState.edit-bank.kind;
                            picked(index) => { AppLogic.edit-bank-set("kind", index); }
                        }
                        EditNumber {
                            label: "Rows";
                            value: AppState.edit-bank.rows;
                            minimum: 1;
                            maximum: 16;
                            changed(value) => { AppLogic.edit-bank-set("rows", value); }
                        }
                        EditNumber {
                            label: "Columns";
                            value: AppState.edit-bank.columns;
                            minimum: 1;
                            maximum: 32;
                            changed(value) => { AppLogic.edit-bank-set("columns", value); }
                        }
                        if AppState.edit-bank.rows > 1 : Segmented {
                            options: ["Top row first", "Bottom row first"];
                            current: AppState.edit-bank.numbering;
                            picked(index) => { AppLogic.edit-bank-set("numbering", index); }
                        }
                        EditCaption { text: "Sends"; }
                        Segmented {
                            options: ["CC", "Note", "Pitch bend"];
                            current: AppState.edit-bank.message;
                            picked(index) => { AppLogic.edit-bank-set("message", index); }
                        }
                        EditNumber {
                            label: "Channel";
                            value: AppState.edit-bank.channel;
                            minimum: 1;
                            maximum: 16;
                            changed(value) => { AppLogic.edit-bank-set("channel", value); }
                        }
                        if AppState.edit-bank.message != 2 : EditNumber {
                            label: AppState.edit-bank.message == 0 ? "First CC" : "First note";
                            value: AppState.edit-bank.first;
                            changed(value) => { AppLogic.edit-bank-set("first", value); }
                        }
                        if AppState.edit-bank.message != 2 : EditNumber {
                            label: "Step";
                            value: AppState.edit-bank.step;
                            minimum: 1;
                            maximum: 16;
                            changed(value) => { AppLogic.edit-bank-set("step", value); }
                        }
                        if AppState.edit-bank.kind == 2 : VerticalLayout {
                            spacing: 2px;
                            EditCaption { text: "While held, also sends"; }
                            Segmented {
                                options: ["Nothing", "Pressure", "Poly pressure"];
                                current: AppState.edit-bank.pressure;
                                picked(index) => { AppLogic.edit-bank-set("pressure", index); }
                            }
                        }
                        Text {
                            text: "Motor faders, LED rings and lit pads or buttons can show a value sent back.";
                            color: Theme.text-faint;
                            font-size: Theme.small-font-size;
                            wrap: word-wrap;
                        }
                        CheckBox {
                            text: "Shows values sent back";
                            checked: AppState.edit-bank.feedback;
                            property <bool> source: AppState.edit-bank.feedback;
                            changed source => { self.checked = self.source; }
                            toggled => { AppLogic.edit-bank-set("feedback", self.checked ? 1 : 0); }
                        }
                        if AppState.edit-bank.feedback && AppState.edit-bank.kind >= 2 : EditNumber {
                            label: "Lit at";
                            value: AppState.edit-bank.lit;
                            minimum: 1;
                            changed(value) => { AppLogic.edit-bank-set("lit", value); }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            KButton {
                                text: "Learn bank";
                                active: AppState.edit-listening == 1;
                                clicked => { AppLogic.edit-learn(1); }
                            }
                            KButton {
                                text: "Delete bank";
                                clicked => { AppLogic.edit-delete-bank(); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Text {
                            text: "\"Learn bank\" listens: move or press each of its controls in turn. Click a control to learn just that one.";
                            color: Theme.text-faint;
                            font-size: Theme.small-font-size;
                            wrap: word-wrap;
                        }
                    }
                    if AppState.edit-can-delete : HorizontalLayout {
                        alignment: start;
                        KButton {
                            text: "Delete surface";
                            clicked => { AppLogic.edit-delete-surface(); }
                        }
                    }
                }
            }
        }
        // The surface, its banks framed.
        Rectangle {
            horizontal-stretch: 1;
            clip: true;
            Flickable {
                content-width: max(self.width, AppState.edit-surface.width * 1px + 40px);
                content-height: max(self.height, AppState.edit-surface.height * 1px + 60px);
                Rectangle {
                    x: 20px;
                    y: 24px;
                    width: AppState.edit-surface.width * 1px;
                    height: AppState.edit-surface.height * 1px;
                    for bank[index] in AppState.edit-banks : Rectangle {
                        visible: !bank.hidden;
                        x: bank.x * 1px - 4px;
                        y: bank.y * 1px - 4px;
                        width: bank.width * 1px + 8px;
                        height: bank.height * 1px + 8px;
                        border-radius: 4px;
                        border-width: bank.selected ? 2px : 1px;
                        border-color: bank.selected ? Theme.accent : Theme.control-border;
                    }
                    for control[index] in AppState.edit-surface.controls : Rectangle {
                        visible: !control.hidden;
                        x: control.x * 1px;
                        y: control.y * 1px;
                        width: control.width * 1px;
                        height: control.height * 1px;
                        border-radius: 4px;
                        border-width: control.selected ? 2px : area.has-hover ? 1px : 0px;
                        border-color: control.selected ? Theme.accent : Theme.control-border;
                        if control.kind == 0 : SurfaceFader { control: control; }
                        if control.kind == 1 : SurfaceKnob { control: control; }
                        if control.kind == 2 : SurfacePad { control: control; }
                        if control.kind == 3 : SurfaceButton { control: control; }
                        area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.edit-learn-control(index); }
                        }
                    }
                    // Each bank's handle, above it: click selects, drag moves.
                    for bank[index] in AppState.edit-banks : Rectangle {
                        visible: !bank.hidden;
                        x: bank.x * 1px - 4px;
                        y: bank.y * 1px - 4px - root.handle;
                        width: bank.width * 1px + 8px;
                        height: root.handle;
                        border-radius: 3px;
                        background: bank.selected ? Theme.accent : handle-area.has-hover ? Theme.control-hover : Theme.control;
                        Text {
                            x: 4px;
                            width: parent.width - 8px;
                            text: bank.name;
                            font-size: 10px;
                            color: bank.selected ? Theme.on-accent : Theme.text-muted;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        handle-area := TouchArea {
                            mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
                            pointer-event(event) => {
                                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                    AppLogic.edit-select-bank(index);
                                }
                            }
                            moved => {
                                if (self.pressed) {
                                    AppLogic.edit-move-bank(index,
                                        bank.x + (self.mouse-x - self.pressed-x) / 1px,
                                        bank.y + (self.mouse-y - self.pressed-y) / 1px);
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    add-menu := PopupWindow {
        x: 10px + 0px;
        y: 90px;
        width: 220px;
        close-policy: PopupClosePolicy.close-on-click-outside;
        PopupFrame {
            VerticalLayout {
                padding: 4px;
                for item[index] in ["Bank of faders", "Bank of knobs", "Bank of pads", "Bank of buttons", "A fader", "A knob", "A pad", "A button"] : ListItem {
                    text: item;
                    clicked => {
                        AppLogic.edit-add(Math.mod(index, 4), index >= 4);
                        add-menu.close();
                    }
                }
            }
        }
    }
}
