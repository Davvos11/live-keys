import { AppState } from "globals.slint";
import { Theme } from "theme.slint";
import { ScenesPane } from "scenes.slint";
import { SlotPanel } from "slot_panel.slint";

// How many slots there are per row of the grid.
export global SlotGrid {
    out property <int> columns: 3;
}

// The scenes on the left, then the slots in a grid of `SlotGrid.columns`.
export component LiveTab inherits Rectangle {
    callback choose-plugin(/* slot */ int, /* category */ int);

    background: Theme.background;

    HorizontalLayout {
        ScenesPane {
            width: 300px;
        }
        VerticalLayout {
            for row[row-index] in Math.ceil(AppState.slots.length / SlotGrid.columns) : HorizontalLayout {
                for column[column-index] in SlotGrid.columns : SlotPanel {
                    property <int> index: row-index * SlotGrid.columns + column-index;
                    slot-index: self.index;
                    slot: AppState.slots[self.index];
                    visible: self.index < AppState.slots.length;
                    choose-plugin(category) => { root.choose-plugin(self.index, category); }
                    // Equal sizes regardless of what each slot's content prefers.
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    preferred-width: 0px;
                    preferred-height: 0px;
                    min-height: 300px;
                }
            }
        }
    }
}
