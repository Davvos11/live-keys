import { Button, VerticalBox, HorizontalBox, ListView, Slider } from "std-widgets.slint";
import { AppState, AppLogic } from "globals.slint";

export component LiveTab inherits VerticalBox {
    Text {
        text: AppState.loaded-plugin-name == "" ? "No plugin loaded" : "Loaded: \{AppState.loaded-plugin-name}";
        font-size: 18px;
    }

    HorizontalBox {
        Button {
            text: AppState.plugin-gui-supported ? "Open Plugin GUI" : "Open Plugin GUI (\{AppState.plugin-gui-status})";
            enabled: AppState.plugin-gui-supported && !AppState.plugin-gui-open;
            clicked => { AppLogic.open-plugin-gui(); }
        }
        Button {
            text: "Close Plugin GUI";
            enabled: AppState.plugin-gui-open;
            clicked => { AppLogic.close-plugin-gui(); }
        }
    }

    if AppState.control-ports.length > 0 : Text {
        text: "Parameters";
        font-size: 18px;
    }

    ListView {
        height: AppState.control-ports.length > 0 ? 200px : 0px;
        for port in AppState.control-ports : HorizontalBox {
            Text {
                text: port.name;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Slider {
                width: 200px;
                minimum: port.min-value;
                maximum: port.max-value;
                value: port.default-value;
                changed(value) => { AppLogic.set-control-param(port.port-index, value); }
            }
        }
    }

    ListView {
        for plugin in AppState.plugins : HorizontalBox {
            Text {
                text: plugin.name;
                horizontal-stretch: 1;
            }
            Button {
                text: "Load";
                clicked => { AppLogic.load-plugin(plugin.uri); }
            }
        }
    }
}
