import { ListView } from "std-widgets.slint";
import { AppState, AppLogic, EffectRow, PresetRow } from "globals.slint";
import { Theme, Icons, Icon, KButton, TextField } from "widgets.slint";

// One preset in a preset browser, with a star to make it a favourite.
component PresetItem inherits Rectangle {
    in property <PresetRow> preset;
    callback choose();
    callback toggle-pin();

    height: 30px;
    border-radius: Theme.radius;
    background: root.preset.current ? Theme.accent : choose-area.has-hover ? Theme.control-hover : transparent;

    // Behind the layout, so the star gets its own clicks and the rest of the row
    // chooses.
    choose-area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.choose(); }
    }
    if root.preset.after-pinned : Rectangle {
        y: 0;
        height: 1px;
        background: Theme.control-border;
    }
    HorizontalLayout {
        padding-right: 8px;
        spacing: 2px;
        Rectangle {
            width: 30px;
            Icon {
                width: 16px;
                height: 16px;
                source: Icons.star;
                tint: root.preset.pinned ? (root.preset.current ? Theme.on-accent : Theme.accent)
                    : star-area.has-hover ? Theme.text-muted : Theme.text-faint;
            }
            star-area := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toggle-pin(); }
            }
        }
        Text {
            text: root.preset.name;
            color: root.preset.current ? Theme.on-accent : Theme.text;
            font-size: Theme.font-size;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.preset.user : Text {
            text: "user";
            font-size: Theme.tiny-font-size;
            color: root.preset.current ? Theme.on-accent : Theme.text-faint;
            vertical-alignment: center;
        }
    }
}

// A plugin's presets, opened from its preset dropdown: a search (Enter loads the
// first match) over its presets, favourites first; loading one closes it.
// Below, saving the current settings as a preset (an inline name, prefilled
// with the current user preset's, so saving again overwrites it) and deleting
// the current one if the user saved it. The browser itself lives in Rust, for
// `AppState.preset-browser-key`; open it with `AppLogic.open-preset-browser`
// before showing this.
export component PresetPopup inherits PopupWindow {
    in property <EffectRow> plugin;

    // 0: browsing, 1: naming a preset to save, 2: confirming a delete.
    property <int> mode: 0;
    // Loading a preset closes the browser in Rust; follow it.
    property <bool> browsing: AppState.preset-browser-key == root.plugin.key && root.plugin.key >= 0;
    changed browsing => {
        if (!self.browsing) {
            root.close();
        }
    }

    close-policy: PopupClosePolicy.close-on-click-outside;

    Rectangle {
        background: Theme.background;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.control-border;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000060;

        VerticalLayout {
            padding: 6px;
            spacing: 6px;

            search := TextField {
                placeholder: "Search presets";
                icon: Icons.search;
                text: AppState.preset-query;
                init => { self.grab-focus(); }
                edited(text) => { AppLogic.filter-presets(text); }
                accepted => {
                    if (AppState.preset-rows.length > 0) {
                        AppLogic.load-preset(0);
                    }
                }
            }

            if AppState.preset-rows.length == 0 : Text {
                text: AppState.preset-count == 0 ? "This plugin has no presets." : "No presets match \"\{search.text}\".";
                color: Theme.text-faint;
                font-size: Theme.small-font-size;
                wrap: word-wrap;
                vertical-stretch: 1;
            }
            if AppState.preset-rows.length > 0 : ListView {
                vertical-stretch: 1;
                for row[index] in AppState.preset-rows : PresetItem {
                    preset: row;
                    choose => { AppLogic.load-preset(index); }
                    toggle-pin => { AppLogic.toggle-preset-pin(index); }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.divider;
            }

            if root.mode == 0 : HorizontalLayout {
                spacing: 4px;
                Text {
                    text: root.plugin.preset-name == "" ? "" : root.plugin.preset-changed ? "\{root.plugin.preset-name} (changed)" : root.plugin.preset-name;
                    color: Theme.text-faint;
                    font-size: Theme.small-font-size;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                KButton {
                    icon: Icons.save;
                    text: "Save…";
                    clicked => { root.mode = 1; }
                }
                KButton {
                    icon: Icons.trash;
                    enabled: root.plugin.preset-user;
                    clicked => { root.mode = 2; }
                }
            }
            if root.mode == 1 : HorizontalLayout {
                spacing: 4px;
                name := TextField {
                    horizontal-stretch: 1;
                    placeholder: "Preset name";
                    // Saving over the current user preset is the common case.
                    text: root.plugin.preset-user ? root.plugin.preset-name : "";
                    init => { self.grab-focus(); }
                    accepted(text) => {
                        if (text != "") {
                            AppLogic.save-preset(root.plugin.key, text);
                            root.mode = 0;
                        }
                    }
                }
                KButton {
                    text: "Save";
                    active: true;
                    enabled: name.text != "";
                    clicked => {
                        AppLogic.save-preset(root.plugin.key, name.text);
                        root.mode = 0;
                    }
                }
                KButton {
                    icon: Icons.close;
                    clicked => { root.mode = 0; }
                }
            }
            if root.mode == 2 : HorizontalLayout {
                spacing: 4px;
                Text {
                    text: "Delete \"\{root.plugin.preset-name}\"?";
                    color: Theme.text;
                    font-size: Theme.small-font-size;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                KButton {
                    text: "Delete";
                    active: true;
                    clicked => {
                        AppLogic.delete-preset(root.plugin.key);
                        root.mode = 0;
                    }
                }
                KButton {
                    icon: Icons.close;
                    clicked => { root.mode = 0; }
                }
            }
        }
    }
}
