import { Button, ComboBox, LineEdit, ListView, Palette, Slider, Switch, VerticalBox } from "std-widgets.slint";
import { ParamRow } from "globals.slint";

// One parameter, with the control its kind calls for: a switch, a dropdown, a
// stepped slider (numbers, notes), or a slider — linear or logarithmic. Values
// the plugin takes are sent as they are; snapping to steps happens on the host
// side.
component ParamControl inherits VerticalLayout {
    in property <ParamRow> param;
    callback set(/* value */ float);

    padding-bottom: 6px;
    // Clear of the list's scrollbar.
    padding-right: 12px;
    spacing: 2px;

    HorizontalLayout {
        spacing: 6px;
        Text {
            text: root.param.name;
            overflow: elide;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        // Toggles and choices show their value in the control itself.
        if root.param.kind != 1 && root.param.kind != 3 : Text {
            text: root.param.text;
            color: gray;
            vertical-alignment: center;
        }
        if root.param.kind == 3 : ComboBox {
            horizontal-stretch: 1;
            // Inside a ListView row it otherwise grows far past its natural height.
            max-height: self.min-height;
            model: root.param.choices;
            current-index: root.param.choice-index;
            // Picking sets `current-index` itself, replacing the binding above;
            // this keeps following changes from elsewhere (the plugin's GUI).
            property <int> source: root.param.choice-index;
            changed source => { self.current-index = self.source; }
            selected => { root.set(root.param.choice-values[self.current-index]); }
        }
        if root.param.kind == 1 : Switch {
            checked: self.source;
            property <bool> source: root.param.value > (root.param.min-value + root.param.max-value) / 2;
            changed source => { self.checked = self.source; }
            toggled => { root.set(self.checked ? root.param.max-value : root.param.min-value); }
        }
    }

    if root.param.kind == 0 && root.param.logarithmic : Slider {
        // Position 0..1 along a log scale from min to max.
        minimum: 0;
        maximum: 1;
        value: self.source;
        property <float> source: Math.log(root.param.value / root.param.min-value, root.param.max-value / root.param.min-value);
        changed source => { self.value = self.source; }
        changed(position) => {
            root.set(root.param.min-value * Math.pow(root.param.max-value / root.param.min-value, position));
        }
    }

    if (root.param.kind == 0 && !root.param.logarithmic) || root.param.kind == 2 || root.param.kind == 4 : Slider {
        minimum: root.param.min-value;
        maximum: root.param.max-value;
        step: root.param.steps > 0 ? (root.param.max-value - root.param.min-value) / root.param.steps : (root.param.max-value - root.param.min-value) / 100;
        value: self.source;
        // Dragging sets `value` itself, replacing its binding; this keeps
        // following changes from elsewhere (the plugin's GUI).
        property <float> source: root.param.value;
        changed source => { self.value = self.source; }
        changed(value) => { root.set(value); }
    }
}

// Load a preset from a menu, save the current settings as one, or delete one
// the user saved. Saving and deleting ask for a name or confirmation inline.
component PresetBar inherits VerticalLayout {
    in property <[string]> presets;
    // Whether each preset was saved by the user (only those can be deleted).
    in property <[bool]> preset-user;
    // The preset last loaded or saved; -1 if none.
    in property <int> preset-index;
    in property <string> status;
    callback load(/* index */ int);
    callback save(/* name */ string);
    callback delete(/* index */ int);

    // 0: the menu, 1: naming a preset to save, 2: confirming a delete.
    property <int> mode: 0;
    property <bool> can-delete: root.preset-index >= 0 && root.preset-user[root.preset-index];

    spacing: 4px;

    if root.mode == 0 : HorizontalLayout {
        spacing: 6px;
        // Otherwise the row grows to fill the window (std ComboBox/Button
        // don't cap their height).
        max-height: self.min-height;
        ComboBox {
            horizontal-stretch: 1;
            enabled: root.presets.length > 0;
            model: root.presets.length > 0 ? root.presets : ["No presets"];
            current-index: self.source;
            // Picking sets `current-index` itself, replacing its binding; this
            // keeps following the host (a save, a failed load).
            property <int> source: root.presets.length > 0 ? root.preset-index : 0;
            changed source => { self.current-index = self.source; }
            selected => { root.load(self.current-index); }
        }
        Button {
            text: "Save…";
            clicked => { root.mode = 1; }
        }
        Button {
            text: "Delete";
            enabled: root.can-delete;
            clicked => { root.mode = 2; }
        }
    }

    if root.mode == 1 : HorizontalLayout {
        spacing: 6px;
        max-height: self.min-height;
        name := LineEdit {
            horizontal-stretch: 1;
            placeholder-text: "Preset name";
            // Saving over the current user preset is the common case.
            text: root.can-delete ? root.presets[root.preset-index] : "";
            init => { self.focus(); }
            accepted => {
                if (self.text != "") {
                    root.save(self.text);
                    root.mode = 0;
                }
            }
        }
        Button {
            text: "Save";
            primary: true;
            enabled: name.text != "";
            clicked => {
                root.save(name.text);
                root.mode = 0;
            }
        }
        Button {
            text: "Cancel";
            clicked => { root.mode = 0; }
        }
    }

    if root.mode == 2 : HorizontalLayout {
        spacing: 6px;
        max-height: self.min-height;
        Text {
            text: "Delete \"\{root.presets[root.preset-index]}\"?";
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Button {
            text: "Delete";
            primary: true;
            clicked => {
                root.delete(root.preset-index);
                root.mode = 0;
            }
        }
        Button {
            text: "Cancel";
            clicked => { root.mode = 0; }
        }
    }

    if root.status != "" : Text {
        text: root.status;
        color: gray;
        font-size: 11px;
        wrap: word-wrap;
    }
}

// A window of its own per plugin: its presets, and its parameters — an editor
// usable whether or not the plugin has its own GUI. Opened from a chain row's
// "Params" button. Its own callbacks rather than `AppLogic`'s, since every
// window has its own instance of each global.
export component ParamsWindow inherits Window {
    in property <string> plugin-name;
    in property <[ParamRow]> params;
    in property <[string]> presets;
    in property <[bool]> preset-user;
    in property <int> preset-index: -1;
    in property <string> status;
    callback set-param(/* param-id */ int, float);
    callback load-preset(/* index */ int);
    callback save-preset(/* name */ string);
    callback delete-preset(/* index */ int);

    title: "\{root.plugin-name} — Parameters";
    preferred-width: 420px;
    preferred-height: 640px;
    min-width: 300px;
    min-height: 200px;
    background: Palette.background;

    VerticalBox {
        Text {
            text: root.plugin-name;
            font-size: 15px;
            font-weight: 600;
            overflow: elide;
        }
        PresetBar {
            presets: root.presets;
            preset-user: root.preset-user;
            preset-index: root.preset-index;
            status: root.status;
            load(index) => { root.load-preset(index); }
            save(name) => { root.save-preset(name); }
            delete(index) => { root.delete-preset(index); }
        }
        Rectangle {
            height: 1px;
            background: Palette.border;
        }
        if root.params.length == 0 : Text {
            text: "This plugin has no parameters to show.";
            color: gray;
        }
        ListView {
            vertical-stretch: 1;
            for param in root.params : ParamControl {
                param: param;
                set(value) => { root.set-param(param.param-id, value); }
            }
        }
    }
}
