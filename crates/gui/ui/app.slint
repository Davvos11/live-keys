import { Palette, Spinner, TabWidget } from "std-widgets.slint";
import { SettingsTab } from "settings_tab.slint";
import { LiveTab } from "live_tab.slint";
import { PickerTarget, PluginPicker } from "plugin_picker.slint";
import { AppState, AppLogic } from "globals.slint";
import { ParamsWindow } from "params_window.slint";
import { Theme } from "theme.slint";

export { AppState, AppLogic, ParamsWindow }

export component AppWindow inherits Window {
    title: "Live Keys";
    preferred-width: 1200px;
    preferred-height: 860px;
    default-font-family: Theme.font-family;
    default-font-size: 16px;

    TabWidget {
        Tab {
            title: "Settings";
            SettingsTab { }
        }
        Tab {
            title: "Live";
            LiveTab {
                choose-plugin(slot, category) => {
                    AppLogic.filter-picker(category, "");
                    PickerTarget.slot = slot;
                    PickerTarget.category = category;
                    picker.show();
                }
            }
            // Over the tab, rather than instead of it, so the window still sizes
            // itself to the tab's contents.
            if AppState.starting : Rectangle {
                width: 100%;
                height: 100%;
                background: Palette.background;
                // Takes the clicks meant for the tab underneath.
                TouchArea { }
                VerticalLayout {
                    alignment: center;
                    spacing: 8px;
                    HorizontalLayout {
                        alignment: center;
                        Spinner {
                            indeterminate: true;
                            width: 32px;
                            height: 32px;
                        }
                    }
                    Text {
                        text: "Loading plugins…";
                        color: gray;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }

    picker := PluginPicker {
        width: min(520px, root.width - 32px);
        height: max(240px, root.height - 64px);
        x: (root.width - self.width) / 2;
        y: 32px;
    }
}
