import { TabWidget } from "std-widgets.slint";
import { SettingsTab } from "settings_tab.slint";
import { LiveTab } from "live_tab.slint";
import { PickerTarget, PluginPicker } from "plugin_picker.slint";
import { AppState, AppLogic } from "globals.slint";
import { ParamsWindow } from "params_window.slint";

export { AppState, AppLogic, ParamsWindow }

export component AppWindow inherits Window {
    title: "Live Keys";
    preferred-width: 900px;
    preferred-height: 760px;

    TabWidget {
        Tab {
            title: "Settings";
            SettingsTab { }
        }
        Tab {
            title: "Live";
            LiveTab {
                choose-plugin(slot, category) => {
                    AppLogic.filter-picker(category, "");
                    PickerTarget.slot = slot;
                    PickerTarget.category = category;
                    picker.show();
                }
            }
        }
    }

    picker := PluginPicker {
        width: min(520px, root.width - 32px);
        height: max(240px, root.height - 64px);
        x: (root.width - self.width) / 2;
        y: 32px;
    }
}
