import { Palette, Spinner } from "std-widgets.slint";
import { LiveTab } from "live_tab.slint";
import { Sidebar } from "sidebar.slint";
import { PickerTarget, PluginPicker } from "plugin_picker.slint";
import { AppState, AppLogic, Category } from "globals.slint";
import { ParamsWindow } from "params_window.slint";
import { SettingsWindow } from "settings_window.slint";
import { Theme } from "theme.slint";

export { AppState, AppLogic, ParamsWindow, SettingsWindow }

// The Live view (scenes and slots, 1200×995 in the Penpot design's "Live
// (window minimum)") and the right sidebar (300 wide) beside it.
export component AppWindow inherits Window {
    title: "Live Keys";
    min-width: 1500px;
    min-height: 995px;
    preferred-width: 1500px;
    preferred-height: 995px;
    default-font-family: Theme.font-family;
    default-font-size: 16px;

    function choose-plugin(slot: int, category: int) {
        AppLogic.filter-picker(category, "");
        PickerTarget.slot = slot;
        PickerTarget.category = category;
        picker.show();
    }

    HorizontalLayout {
        Rectangle {
            horizontal-stretch: 1;
            LiveTab {
                choose-plugin(slot, category) => { root.choose-plugin(slot, category); }
            }
            // Over the slots, rather than instead of them, so the window still
            // sizes itself to them.
            if AppState.starting : Rectangle {
                width: 100%;
                height: 100%;
                background: Palette.background;
                // Takes the clicks meant for the slots underneath.
                TouchArea { }
                VerticalLayout {
                    alignment: center;
                    spacing: 8px;
                    HorizontalLayout {
                        alignment: center;
                        Spinner {
                            indeterminate: true;
                            width: 32px;
                            height: 32px;
                        }
                    }
                    Text {
                        text: "Loading plugins…";
                        color: gray;
                        horizontal-alignment: center;
                    }
                }
            }
        }
        Sidebar {
            choose-effect => { root.choose-plugin(AppState.master-slot, Category.audio-effect); }
        }
    }

    picker := PluginPicker {
        width: min(520px, root.width - 32px);
        height: max(240px, root.height - 64px);
        x: (root.width - self.width) / 2;
        y: 32px;
    }
}
