import { ListView } from "std-widgets.slint";
import { AppLogic, AppState, SceneRow } from "globals.slint";
import { Theme, Icons, KButton, ListItem, TextField } from "widgets.slint";

// A scene row. Clicking recalls it; dragging moves it in the list; right-click
// offers loading, saving over, renaming, duplicating and deleting it. A changed
// one shows "changed", and while hovered, buttons to save or discard the
// changes.
component SceneItem inherits Rectangle {
    in property <SceneRow> entry;
    // Where a row being dragged here would land: 0 nowhere, 1 above this row,
    // 2 below it.
    in property <int> drop-line;
    in property <bool> dragged;
    callback choose();
    callback overwrite();
    callback edit();
    callback duplicate();
    callback delete();
    callback save-changes();
    callback discard-changes();
    // While dragging, and on letting go: how many rows down (negative: up)
    // from this one the pointer is.
    callback drag(/* rows */ int);
    callback drop(/* rows */ int);
    callback drag-cancelled();

    property <bool> dragging;

    function rows-moved() -> int {
        // Rows are spaced 5px apart in the list.
        return Math.round((area.mouse-y - area.pressed-y) / (root.height + 5px));
    }

    height: Theme.control-height;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.control-border;
    background: root.entry.current ? Theme.accent
        : area.has-hover ? Theme.control-hover : Theme.control;
    opacity: root.dragged ? 0.5 : 1;

    area := TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(event) => {
            if event.kind == PointerEventKind.cancel {
                if root.dragging {
                    root.drag-cancelled();
                }
                root.dragging = false;
                return;
            }
            if event.button != PointerEventButton.left {
                return;
            }
            if event.kind == PointerEventKind.down {
                root.dragging = false;
            } else if event.kind == PointerEventKind.up {
                if root.dragging {
                    root.drop(root.rows-moved());
                } else {
                    root.choose();
                }
                root.dragging = false;
            }
        }
        moved => {
            if self.pressed && Math.abs(self.mouse-y - self.pressed-y) > 4px {
                root.dragging = true;
            }
            if root.dragging {
                root.drag(root.rows-moved());
            }
        }

        // Children of the touch area, so hovering them keeps the row hovered.
        if root.entry.changed && self.has-hover && !root.dragging : HorizontalLayout {
            x: parent.width - self.preferred-width - 4px;
            width: self.preferred-width;
            alignment: end;
            spacing: 3px;
            padding-top: 3px;
            padding-bottom: 3px;
            KButton {
                width: 26px;
                height: 26px;
                icon: Icons.save;
                icon-size: 18px;
                tooltip: "Save changes";
                clicked => { root.save-changes(); }
            }
            KButton {
                width: 26px;
                height: 26px;
                icon: Icons.undo;
                icon-size: 18px;
                tooltip: "Discard changes";
                clicked => { root.discard-changes(); }
            }
        }
    }

    // On top of the touch area, which would otherwise take the right-click;
    // other clicks pass through.
    ContextMenuArea {
        Menu {
            MenuItem {
                title: "Load";
                activated => { root.choose(); }
            }
            MenuItem {
                title: "Save (overwrite)";
                activated => { root.overwrite(); }
            }
            MenuItem {
                title: "Rename…";
                activated => { root.edit(); }
            }
            MenuItem {
                title: "Duplicate";
                activated => { root.duplicate(); }
            }
            MenuItem {
                title: "Delete…";
                activated => { root.delete(); }
            }
        }
        width: 100%;
        height: 100%;
    }

    HorizontalLayout {
        padding-left: 7px;
        // Clear of the hover buttons.
        padding-right: root.entry.changed && area.has-hover && !root.dragging ? 62px : 6px;
        spacing: 3px;
        Text {
            text: root.entry.name;
            color: root.entry.current ? Theme.on-accent : Theme.text;
            font-size: Theme.font-size;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        // The hover buttons take its place.
        if root.entry.changed && !(area.has-hover && !root.dragging) : Text {
            text: "changed";
            color: root.entry.current ? Theme.on-accent : Theme.text-faint;
            font-size: Theme.small-font-size;
            vertical-alignment: center;
        }
    }

    if root.drop-line != 0 : Rectangle {
        y: root.drop-line == 1 ? -1px : root.height - 1px;
        height: 2px;
        background: Theme.accent;
    }
}

// The Live tab's left pane: a search over the scenes, then the list — "+ New
// scene" (saving the slots as a scene), and the scenes; the current one in the
// primary colour. A scene shows "changed" once a slot changed since it was
// recalled or saved, and keeps its changes (as a draft) when another is
// recalled. Clicking a scene recalls it straight away; right-clicking one
// offers saving over, renaming and deleting it.
export component ScenesPane inherits VerticalLayout {
    // 0: browsing, 1: saving, 2: confirming a delete, 3: renaming.
    property <int> mode: 0;
    // The row being dragged and the row it would land on; -1 when not dragging.
    property <int> drag-from: -1;
    property <int> drag-to: -1;

    function submit(name: string) {
        if (name == "") {
            return;
        }
        if (root.mode == 1) {
            AppLogic.save-scene(name);
        } else {
            AppLogic.edit-scene(name);
        }
        root.mode = 0;
    }

    padding: 10px;
    spacing: 6px;

    TextField {
        placeholder: "Search scenes...";
        icon: Icons.search;
        edited(text) => { AppLogic.filter-scenes(text); }
        accepted => { AppLogic.load-scene(0); }
    }

    Rectangle {
        vertical-stretch: 1;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.control-border;

        VerticalLayout {
            padding: 6px;
            spacing: 5px;

            if root.mode == 0 : ListItem {
                text: "+ New scene";
                action: true;
                clicked => {
                    AppLogic.begin-scene-save();
                    root.mode = 1;
                }
            }

            if root.mode == 1 || root.mode == 3 : VerticalLayout {
                spacing: 6px;
                name := TextField {
                    placeholder: "Scene name";
                    // Saving over the current scene is the common case;
                    // renaming starts from the scene's own name.
                    text: AppState.scene-target-name;
                    init => { self.grab-focus(); }
                    accepted(text) => { root.submit(text); }
                }
                HorizontalLayout {
                    spacing: 4px;
                    KButton {
                        text: root.mode == 1 ? "Save" : "Rename";
                        active: true;
                        horizontal-stretch: 1;
                        enabled: name.text != "";
                        clicked => { root.submit(name.text); }
                    }
                    KButton {
                        text: "Cancel";
                        horizontal-stretch: 1;
                        clicked => { root.mode = 0; }
                    }
                }
            }

            if root.mode == 2 : VerticalLayout {
                spacing: 6px;
                Text {
                    text: "Delete \"\{AppState.scene-target-name}\"?";
                    color: Theme.text;
                    font-size: Theme.font-size;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 4px;
                    KButton {
                        text: "Delete";
                        active: true;
                        horizontal-stretch: 1;
                        clicked => {
                            AppLogic.delete-scene();
                            root.mode = 0;
                        }
                    }
                    KButton {
                        text: "Cancel";
                        horizontal-stretch: 1;
                        clicked => { root.mode = 0; }
                    }
                }
            }

            if AppState.scene-status != "" : Text {
                text: AppState.scene-status;
                color: Theme.text-muted;
                font-size: Theme.small-font-size;
                wrap: word-wrap;
            }

            if AppState.scene-rows.length == 0 : Text {
                text: AppState.scene-count == 0 ? "No scenes yet." : "No matching scenes.";
                color: Theme.text-faint;
                font-size: Theme.small-font-size;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
            ListView {
                vertical-stretch: 1;
                for row[index] in AppState.scene-rows : VerticalLayout {
                    padding-bottom: 5px;
                    SceneItem {
                        entry: row;
                        dragged: index == root.drag-from;
                        drop-line: root.drag-from < 0 || index != root.drag-to || index == root.drag-from ? 0
                            : index < root.drag-from ? 1 : 2;
                        choose => { AppLogic.load-scene(index); }
                        overwrite => { AppLogic.overwrite-scene(index); }
                        duplicate => { AppLogic.duplicate-scene(index); }
                        save-changes => { AppLogic.save-scene-changes(index); }
                        discard-changes => { AppLogic.discard-scene-changes(index); }
                        edit => {
                            AppLogic.begin-scene-edit(index);
                            root.mode = 3;
                        }
                        delete => {
                            AppLogic.begin-scene-delete(index);
                            root.mode = 2;
                        }
                        drag(rows) => {
                            root.drag-from = index;
                            root.drag-to = Math.clamp(index + rows, 0, AppState.scene-rows.length - 1);
                        }
                        drag-cancelled => {
                            root.drag-from = -1;
                            root.drag-to = -1;
                        }
                        drop(rows) => {
                            AppLogic.move-scene(index, Math.clamp(index + rows, 0, AppState.scene-rows.length - 1));
                            root.drag-from = -1;
                            root.drag-to = -1;
                        }
                    }
                }
            }
        }
    }
}
